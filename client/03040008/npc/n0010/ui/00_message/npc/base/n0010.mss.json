  "FileSize" : 2232,
  "NativeMsgDataArrayNum" : 51,
  "NativeMsgGroupArray" : [ {
    "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgGroup",
    "GroupNameSerial" : 0,
    "GroupSerial" : 13961,
    "GroupType" : 44,
    "GroupTypeName" : "MSG_GROUP_TYPE_JM_TUTO_ORDER",
    "MsgData" : [ {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 0,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "Well... it's somewhat surprising that you, who grew\nup in a world that abhors alchemy, would be\ninterested in becoming an Alchemist.",
        "Jp" : "おや――少々意外ではあるな\n錬金を忌む世で育った君が\n《アルケミスト》に興味を持つとはね"
      },
      "MsgSerial" : 255013,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 1,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "To be honest, I'm troubled by curiosity for\ncuriosity's sake. After all, it involves my\nfuture too.",
        "Jp" : "正直に言って、興味本位は困る\nこれからのわたしの立場もあるからね"
      },
      "MsgSerial" : 255063,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 2,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "Moreover, it would be troublesome if \nyou were to get the wrong idea...",
        "Jp" : "加えて、思い違いをしてもらっては\nやはり困るが――"
      },
      "MsgSerial" : 255064,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 3,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "No, no, I'm sorry. I was just being cautious,\nthat's all.",
        "Jp" : "いやいや、すまない\nどうも警戒が先に立ってしまってね"
      },
      "MsgSerial" : 255065,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 4,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "If it's you, there should be no problem. As long\nas you can overcome the challenges, I would be\nhappy to guide you.",
        "Jp" : "君なら問題ないだろう\n課題さえ乗り越えてくれれば\n喜んで指導させてもらうよ"
      },
      "MsgSerial" : 255066,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    } ],
    "NameDispOff" : false,
    "NpcId" : 10,
    "NpcName" : {
      "En" : "Theodor",
      "Jp" : "テオドール"
    }
  }, {
    "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgGroup",
    "GroupNameSerial" : 0,
    "GroupSerial" : 12754,
    "GroupType" : 21,
    "GroupTypeName" : "MSG_GROUP_TYPE_REV_INVALID_CHARGE",
    "MsgData" : [ {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 5,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "Oh, I see—have you overcome the challenge? You,\nas an Arisen, wish to learn the alchemy that the\nWhite Dragon once sealed away.",
        "Jp" : "ほほう――課題を乗り越えたのか\n君は白竜がかつて封じた錬金術を\n覚者でありながら、学ぼうというんだね"
      },
      "MsgSerial" : 190471,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 6,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "It’s both a joy and a risk...\nbut if that’s what you’ve chosen,\nI’ll respect your decision.",
        "Jp" : "嬉しくもあり、危うくもあり――\nだが君が選んだのなら\n私はその選択を尊重するよ"
      },
      "MsgSerial" : 190472,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 7,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "Well then, let us walk the \npath of Alchemy together.",
        "Jp" : "では、《アルケミスト》として共に歩もう"
      },
      "MsgSerial" : 190473,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 8,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "Alchemy is, in the first place, the study of\nusing human logic to guide people. You might be\nable to coexist with Order, too.",
        "Jp" : "錬金術とはそもそも、人の論理を用い\n人の為に導く学問\n理との共存も、君ならできるかもしれないね"
      },
      "MsgSerial" : 190474,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    } ],
    "NameDispOff" : false,
    "NpcId" : 10,
    "NpcName" : {
      "En" : "Theodor",
      "Jp" : "テオドール"
    }
  }, {
    "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgGroup",
    "GroupNameSerial" : 0,
    "GroupSerial" : 12755,
    "GroupType" : 22,
    "GroupTypeName" : "MSG_GROUP_TYPE_REV_1TIME_1DAY",
    "MsgData" : [ {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 9,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "Quite remarkable, your ability to learn\nquickly. It seems like you're already proficient\nin intermediate level alchemy.",
        "Jp" : "なかなかどうして、覚えが早いな、君は\nもう中等レベルの錬金術は十分に\n使いこなせているようだね"
      },
      "MsgSerial" : 190475,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 10,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "In that case, you might consider delving into\nmore advanced techniques. How about this\ntechnique? Do you think you can handle it?",
        "Jp" : "ならば、もう少し上級の技に手を出して\nみてもいいかもしれない\nこういう技だが、どうだい、やれそうかな？"
      },
      "MsgSerial" : 190476,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    } ],
    "NameDispOff" : false,
    "NpcId" : 10,
    "NpcName" : {
      "En" : "Theodor",
      "Jp" : "テオドール"
    }
  }, {
    "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgGroup",
    "GroupNameSerial" : 0,
    "GroupSerial" : 12756,
    "GroupType" : 23,
    "GroupTypeName" : "MSG_GROUP_TYPE_REV_CHECK_REMAIN",
    "MsgData" : [ {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 11,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "Hmm, you’re going to be something to watch out for.\nTo have grown so much in such a short time...\nEven Diamantes—\nAh, let’s not go there.",
        "Jp" : "ううむ、末恐ろしいな、君は\nこの短期間でこれほどまでに成長するとは\nわたし、ディアマンテスでさえ――\n――いや、やめておこう"
      },
      "MsgSerial" : 190477,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 12,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "Listen, alchemy is the crystallization of logic.\nIt is the art of combining and transforming the\nnatural with artificial characteristics.",
        "Jp" : "いいかね、錬金術は論理の結晶\n自然なるものに、人為的に別の特性を\n組み合わせ変化させる術だ"
      },
      "MsgSerial" : 190478,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 13,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "Your will, the logic you weave is the key to\ntechnique.\nAlways remember that and face the future of your\nart.",
        "Jp" : "君の意思、君が紡いだ論理こそが\n技の要となる、それを常に思い出し\nこれからの技に向きあいなさい"
      },
      "MsgSerial" : 190479,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    } ],
    "NameDispOff" : false,
    "NpcId" : 10,
    "NpcName" : {
      "En" : "Theodor",
      "Jp" : "テオドール"
    }
  }, {
    "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgGroup",
    "GroupNameSerial" : 0,
    "GroupSerial" : 13531,
    "GroupType" : 3,
    "GroupTypeName" : "MSG_GROUP_TYPE_EX_TALK",
    "MsgData" : [ {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 14,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "Some forms of alchemy apply the principles of the art to combat techniques.\nThese techniques use one’s own life force as a medium to generate, transform, and rearrange matter.",
        "Jp" : "錬金術の中には、術の論理を戦いの技\nとして応用したものがある\n自身の生命力を媒介に、物質を生成・変換し\n組み変える技だ"
      },
      "MsgSerial" : 211301,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 15,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "As an alchemist, if you're going to study alchemy,\nthen that field would be best for you.",
        "Jp" : "《アルケミスト》として君が錬金術を学ぶ\nなら、そちらの分野がいいだろう"
      },
      "MsgSerial" : 212132,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 16,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "As you know, having witnessed the power of the Furnace,\nthe energy of life attracts both humans and demons alike.\n—Though, of course, compared to that, this is on a much smaller scale.",
        "Jp" : "溶命炉の力を見たのなら知っているとおり\n命のエネルギーは人も魔も惹きつける\n――あれに比べればもちろん、規模こそ小さいがね"
      },
      "MsgSerial" : 212133,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 17,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "If you know the flow and theory of power, and can\nmanipulate it at will, the energy you generate\nwill intersect with the elixir and turn into a\npoison that will weaken your enemies or a medicine\nthat will protect your allies.",
        "Jp" : "力の流れと理論を知り、意思によって自在に\n操ることができれば、君が生成するエネルギーは\nエリクシルと交わることで\n敵を蝕む毒にも、友を守る薬にも変わるだろう"
      },
      "MsgSerial" : 212134,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    } ],
    "NameDispOff" : false,
    "NpcId" : 10,
    "NpcName" : {
      "En" : "Theodor",
      "Jp" : "テオドール"
    }
  }, {
    "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgGroup",
    "GroupNameSerial" : 0,
    "GroupSerial" : 13532,
    "GroupType" : 3,
    "GroupTypeName" : "MSG_GROUP_TYPE_EX_TALK",
    "MsgData" : [ {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 18,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "When dealing with alchemy, the most important\nthing remains the transformation of alchemized\nsubstances and elixirs.",
        "Jp" : "錬金術を扱う上で、もっとも大切なことは\nやはり、錬成物質とエリクシルの変換だろう"
      },
      "MsgSerial" : 211302,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 19,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "An elixir embodies the very nature of an attribute.\nWhen a transmuted substance combines into an elixir and activates,\nit gains various effects.",
        "Jp" : "エリクシルとは属性の性質そのもの\n錬成物質はエリクシルと結合し発動\nすることで、様々な効果を帯びる"
      },
      "MsgSerial" : 265995,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 20,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "The choice of which elixirs to use in each battle\ngreatly affects the outcome of the fight.",
        "Jp" : "どの戦いでどのエリクシルを用いるかが\n戦いの結果にも大きく影響するのだ"
      },
      "MsgSerial" : 265996,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    } ],
    "NameDispOff" : false,
    "NpcId" : 10,
    "NpcName" : {
      "En" : "Theodor",
      "Jp" : "テオドール"
    }
  }, {
    "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgGroup",
    "GroupNameSerial" : 0,
    "GroupSerial" : 14073,
    "GroupType" : 46,
    "GroupTypeName" : "MSG_GROUP_TYPE_APPRAISE_INTRO",
    "MsgData" : [ {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 21,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "So you’re studying to become an Alchemist, aye?\nHow’s it going?\nOnce you start to understand how the arts work, you’ll naturally get the hang of it.",
        "Jp" : "君は《アルケミスト》として学んでいるのだね\n調子はどうだい？\n術の仕組みが解ってくれば\nおのずと慣れてくるだろう"
      },
      "MsgSerial" : 493118,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 22,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "...Right, I'd say around Vocation Lv. 18, or so.",
        "Jp" : "――そうだね、ジョブレベル１８と\nいったところだろうか"
      },
      "MsgSerial" : 256742,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 23,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "Once you have mastered the basics to that extent,\nyou can proceed to the next stage.",
        "Jp" : "それくらい基礎を修めたなら\n次の段階に進んでもいいだろう"
      },
      "MsgSerial" : 256743,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 24,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "However, it would be wise to obtain the approval\nof those who have been observing your battle\nprowess at the temple before continuing as an\nAlchemist.",
        "Jp" : "もっとも、その前に神殿で君の戦いぶりを\n日頃見ているであろう者から\n本当にアルケミストを続けるべきか\n同意はもらっておいた方がいい"
      },
      "MsgSerial" : 256744,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 25,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "If you seek greater things as an alchemist,\nand if those who have witnessed your skill \nat arms grant their permission...\nthen I shall personally instruct you.",
        "Jp" : "君がアルケミストとしてさらなるものを求め\n君の戦いぶりを見ている者も許すのであれば――\nその時はわたしが直接手ほどきをしよう"
      },
      "MsgSerial" : 493119,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    } ],
    "NameDispOff" : false,
    "NpcId" : 10,
    "NpcName" : {
      "En" : "Theodor",
      "Jp" : "テオドール"
    }
  }, {
    "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgGroup",
    "GroupNameSerial" : 0,
    "GroupSerial" : 14074,
    "GroupType" : 43,
    "GroupTypeName" : "MSG_GROUP_TYPE_REGISTERD_ENTRY_TALK",
