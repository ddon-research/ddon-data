    "GroupType" : 0,
    "GroupTypeName" : "MSG_GROUP_TYPE_NONE",
    "MsgData" : [ {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 4,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "I really like the atmosphere of the tavern.\r\nHow about coming to eat something together on our\r\nnext day off? Of course, let's invite Lise too.",
        "Jp" : "酒場の雰囲気、結構好きなんですよ\r\n次の休み、みんなで何か食べに来ませんか\r\nもちろんリズも誘って"
