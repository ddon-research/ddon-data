      "MsgSerial" : 816130,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 5,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "I feel like there hasn't been much time to relax\r\nat the temple recently.",
        "Jp" : "神殿でゆっくりすることって\r\n最近あんまり無い気がして"
      },
      "MsgSerial" : 819794,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
