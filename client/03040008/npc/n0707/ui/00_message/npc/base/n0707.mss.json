      "DispType" : 0,
      "GmdIndex" : 1,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "The memories held within Uruteca Mountains –\r\nchanging the memories of the Fire Dragon Lords\r\nthroughout the generations is absolutely,\r\nabsolutely unforgivable!",
        "Jp" : "《ウルテカ山岳》の持つ記憶――\r\n代々の火竜様との記憶を塗り替えるなど\r\n決して、決して許されたことではない！"
      },
      "MsgSerial" : 789218,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    } ],
    "NameDispOff" : false,
    "NpcId" : 707,
    "NpcName" : {
      "En" : "Selim",
      "Jp" : "セリム"
    }
  }, {
    "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgGroup",
