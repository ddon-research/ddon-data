      "GmdIndex" : 2,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "It is truly frustrating. We are unable\r\nto leave this place.",
        "Jp" : "実に歯がゆい\r\nわしらはこの場を離れることができぬ"
      },
      "MsgSerial" : 725025,
