      "GmdIndex" : 3,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "In the place where heroes and others are\r\nenshrined, I await the arrival of someone like\r\nyou, who will become my strength. This is the\r\npinnacle of our encounter— I too wanted to lead\r\nan army and fight once again.",
        "Jp" : "英霊などと祀られたところで\r\nこうしてお主のように力となってくれる者を\r\n待ち受けるのが関の山――\r\nわしも再び、軍を率いて戦いたかったものだ"
      },
      "MsgSerial" : 725026,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    } ],
    "NameDispOff" : false,
    "NpcId" : 707,
    "NpcName" : {
      "En" : "Selim",
      "Jp" : "セリム"
    }
