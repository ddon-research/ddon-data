    }
  }, {
    "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgGroup",
    "GroupNameSerial" : 0,
    "GroupSerial" : 31545,
    "GroupType" : 83,
    "MsgData" : [ {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 5,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "A furball?\r\nNo, it's a cloth.\r\nIt's rare to find a cloth with this kind of feel.\r\nOh, so this is how you wrap it around your neck...",
        "Jp" : "毛玉――？\r\nいや、布か\r\nこういった感触の布は珍しい\r\nほう――こうして首に巻くのか――"
      },
      "MsgSerial" : 819810,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 6,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "I see, this is warm.\r\nIt must be something unique to Lestania,\r\nwhere it gets this cold.",
        "Jp" : "なるほど、これは暖かいな\r\nこの寒さになるレスタニアならではの物だろう"
      },
      "MsgSerial" : 819811,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 7,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "There is no need to warm your\r\nneck if back in Phindym.\r\nIt might become a decoration that\r\nadorns the hermitage.",
        "Jp" : "フィンダムに戻れば首を温める必要はない\r\n庵を彩る飾りにはなりそうだが"
      },
      "MsgSerial" : 819812,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 8,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "Hmm...\r\nThis must be my umpteenth time coming to Lestania.\r\nBut I have never walked this land with you.",
        "Jp" : "ふむ――\r\nレスタニアに来るのはこれで何度目かになる\r\nだが、貴様とこの地を歩いたことは無かったな"
      },
      "MsgSerial" : 819813,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 9,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "After this festival, I'm going to take a little\r\nlook around outside the temple.\r\nIf you have time, come along.",
        "Jp" : "この祭りが終わったら\r\n神殿の外を少し見て回ろうと思っている\r\n時間があれば、共に来るがいい"
      },
      "MsgSerial" : 819814,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 10,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "I was just interested in fighting the\r\nmonsters of Lestania.\r\nAs a bonus, I'll give you some intense training\r\nto make sure your skills haven't gotten rusty.",
        "Jp" : "――レスタニアの魔物との戦いに\r\n興味が湧いただけだ\r\nついでに、長稽古を付けてやる\r\n腕がなまっていないかの確認としてな"
      },
      "MsgSerial" : 819815,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    } ],
