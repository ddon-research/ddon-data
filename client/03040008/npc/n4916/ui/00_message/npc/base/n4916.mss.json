    "GroupSerial" : 31239,
    "GroupType" : 0,
    "GroupTypeName" : "MSG_GROUP_TYPE_NONE",
    "MsgData" : [ {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 5,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "Does this tavern have anything other than snacks?\r\nIf possible, I'd like something like\r\nstew to warm up.",
        "Jp" : "ここの酒場ってツマミ以外もあるのかな？\r\nできればシチュー的な物で温まりたいよ"
