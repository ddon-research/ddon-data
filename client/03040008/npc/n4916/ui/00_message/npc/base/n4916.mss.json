      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 2,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "It's just that there are a few things that would\r\nbe bad if they were found out!",
        "Jp" : "バレたらマズいことが\r\nいくつかあるってだけさ！"
      },
      "MsgSerial" : 819850,
      "MsgType" : 0,
      "SetMotion" : 0,
