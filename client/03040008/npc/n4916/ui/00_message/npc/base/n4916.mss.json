      "MsgSerial" : 816126,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    } ],
    "NameDispOff" : false,
    "NpcId" : 4916,
    "NpcName" : {
      "En" : "Sonel",
      "Jp" : "ソネル"
    }
  }, {
    "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgGroup",
    "GroupNameSerial" : 0,
    "GroupSerial" : 31544,
    "GroupType" : 83,
    "MsgData" : [ {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 6,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "I've been waiting for ages— But I've been waiting\r\nall this time, thinking you'd give me something.",
        "Jp" : "待ちくたびれたよ――\r\nでも、キミが何かくれるはずだと思って\r\nずっと待ってたんだ"
      },
      "MsgSerial" : 819804,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 7,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "Let's see what you've got!\r\nLet's see what's so \"special\" about it!",
        "Jp" : "さぁ、早速だけど見せておくれよ！\r\nその\"特別\"ってやつを！"
      },
      "MsgSerial" : 819805,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 8,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "Oh, this is the thing!",
        "Jp" : "ああ、コレはアレだね！"
      },
      "MsgSerial" : 819806,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 9,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "That thing - a cloth to decorate the table!\r\nI think it's called a table centerpiece!\r\nYou've given me something very stylish!\r\nThank you, Captain!",
        "Jp" : "アレ――テーブルに飾る布！\r\nテーブルセンターっていうんだっけな\r\nずいぶんオシャレな物をくれるじゃないか！\r\n隊長、ありがとう！"
      },
      "MsgSerial" : 819807,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 10,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "You might know this already, but my belongings,\r\nyou know, have a knack for running off somewhere.",
        "Jp" : "知ってるかもしれないけど\r\nほら、僕の持ち物ときたら\r\n大体どこかへ逃げだすのが得意だからさ"
      },
      "MsgSerial" : 819808,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 11,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "To ensure that this doesn't disappear, it must be\r\nput on the largest table in the house, in the\r\nwidest and best spot!",
        "Jp" : "これはなくならないように\r\n家にある一番大きなテーブルの\r\n一番広くて良い場所に敷いておかないとだ！"
      },
      "MsgSerial" : 819809,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 12,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "Ah, yes, that's right.\r\nI wonder if it's still here.\r\nIt would be nice if the captain could\r\ncome and check on it.\r\n-Really, anytime is fine, so please come and look!",
        "Jp" : "ああ、そうそう\r\nこれが無くなってしまっていないか\r\n隊長が様子を見にきてくれてもいいんだよ\r\n――ほんとにいつでも、見にきてくれていいから！"
      },
      "MsgSerial" : 819918,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    } ],
