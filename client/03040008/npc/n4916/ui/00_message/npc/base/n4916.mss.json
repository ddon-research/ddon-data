    }
  }, {
    "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgGroup",
    "GroupNameSerial" : 0,
    "GroupSerial" : 31238,
    "GroupType" : 0,
    "GroupTypeName" : "MSG_GROUP_TYPE_NONE",
    "MsgData" : [ {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 3,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "Being invited to a foreign country like this...\r\nI'm glad I became a strategist, really!\r\nMaybe I should...\r\nI'm sure I'll learn a lot while I'm sightseeing.",
        "Jp" : "いや～、異国にお呼ばれするなんて\r\n軍師やっててよかったよ、ホント！\r\n観光ついでに色々勉強させてもらおうかな"
      },
      "MsgSerial" : 816127,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 4,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "I just heard that there's a hot spring where\r\neverything comes to life with power?\r\nI'm curious... I'd love to go there.\r\nIf only I had someone to show me around!",
        "Jp" : "さっき聞いたんだけど、なんでも\r\n力が湧いてくる温泉があるんだって？\r\n気になるなぁ、ぜひとも行ってみたいなぁ\r\n案内してくれる人がいればなぁ～"
      },
      "MsgSerial" : 819791,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    } ],
    "NameDispOff" : false,
    "NpcId" : 4916,
    "NpcName" : {
      "En" : "Sonel",
      "Jp" : "ソネル"
    }
  }, {
    "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgGroup",
