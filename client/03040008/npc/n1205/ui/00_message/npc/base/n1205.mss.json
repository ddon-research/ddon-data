      "Jp" : "オニール"
    }
  }, {
    "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgGroup",
    "GroupNameSerial" : 0,
    "GroupSerial" : 12792,
    "GroupType" : 13,
    "GroupTypeName" : "MSG_GROUP_TYPE_NORA_PAWN",
    "MsgData" : [ {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 25,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "-You know, I was really glad when you\r\ncame to Rotes.",
        "Jp" : "――もう、何ていうかさ\r\nあんたがローテスに来てくれて\r\n本当に良かったよ"
      },
      "MsgSerial" : 190559,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 26,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "No one has ever been so kind to me before, not\r\nthe Knights or the Temple, and I'll help you\r\nas much as I can, too.",
