      "GmdIndex" : 61,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "Ah, Arisen...\r\nThere's something I'd like to, ah,\r\nspeak with you about...",
        "Jp" : "か、覚者さん――\r\nちょっと聞いてほしいことが\r\nあ、あるんだけどさ――"
