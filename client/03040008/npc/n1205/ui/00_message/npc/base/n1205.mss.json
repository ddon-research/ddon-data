      "DispType" : 0,
      "GmdIndex" : 23,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "The romance of the sea is the size of it!\r\nThe occasional drifting ship is the best!",
        "Jp" : "海のロマンはやっぱでっかさだろ！\r\nたまに来る漂流船なんか最高さ！"
