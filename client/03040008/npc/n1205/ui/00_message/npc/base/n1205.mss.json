      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 59,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "Hey, you're interested, right?\r\nWould you like to come and look for it?",
        "Jp" : "なぁ、興味あるよな？\r\n探しにってみないかい？"
