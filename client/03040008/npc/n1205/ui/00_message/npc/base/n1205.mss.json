      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 55,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "If you see him, please exterminate him.\r\nI've contacted the Knights of Columbus, but they\r\nhaven't gotten back to me .",
        "Jp" : "もし見かけたら退治してくれよ\r\n騎士団にも連絡したんだけど、なかなか\r\n返事が来なくてさ"
      },
      "MsgSerial" : 255989,
      "MsgType" : 0,
