      "GmdIndex" : 53,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "Have you ever been to the southern\r\nshore, Blue Claw Beach?",
        "Jp" : "南の浜辺――《青爪浜》には行った事が\r\nあるかい？"
