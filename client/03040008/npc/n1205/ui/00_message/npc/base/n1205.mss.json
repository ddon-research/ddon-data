      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 64,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "There's a long-defunct village called Leflor.\r\nHave you ever been there?",
        "Jp" : "ルフローっていうだいぶ前に滅んだ村さ\r\n行ったことはあるかい？"
      },
      "MsgSerial" : 255996,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
