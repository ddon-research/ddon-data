      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 63,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "Anyway, listen, see, I told you before that\r\nthere's an abandoned village on the\r\nsouthern beach, right?",
        "Jp" : "とにかく聞いてくれよ\r\nほら、南の浜辺に廃村があるって話は\r\n前にしただろ？"
