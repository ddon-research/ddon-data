    }
  }, {
    "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgGroup",
    "GroupNameSerial" : 0,
    "GroupSerial" : 13537,
    "GroupType" : 3,
    "GroupTypeName" : "MSG_GROUP_TYPE_EX_TALK",
    "MsgData" : [ {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 17,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "My bow is that of an elven archer, an \"Element\r\nArcher\" to be precise.",
        "Jp" : "私の弓はエルフの弓術師\r\n《エレメントアーチャ―》のものよ"
      },
      "MsgSerial" : 211307,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 18,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "Instead of iron arrows, this specialized bow,\r\nknown as the 'Magick Bow,' fires\r\nspiritual magick arrows.\r\nAnd instead of targeting the enemy's physical\r\nbody, it aims for their spirit.",
        "Jp" : "魔道弓という特殊な弓で、鉄矢ではなく\r\n霊的な魔矢を放つの\r\nそして敵の身体ではなく、そうね\r\n霊を捉えて狙いを定める――ってとこかしら"
      },
      "MsgSerial" : 212607,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 19,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "Hmm, it's difficult to explain in words, but I\r\nthink you'll understand naturally once you try it.",
        "Jp" : "うーん、言葉で説明しにくいけれど\r\nやってみれば自然に解ると思うわ"
      },
      "MsgSerial" : 212608,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 20,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "Oh, and the magick arrows aren't just\r\nfor attacking enemies.\r\nSince they're spiritual arrows, you can imbue\r\nthem with thoughts of healing and support to\r\nrevitalize your allies.",
        "Jp" : "あと、魔矢で射るのは敵だけじゃないのよ\r\n霊的な矢だからね。味方を思う念を込めれば\r\n活力を上げてあげることもできるわ"
      },
      "MsgSerial" : 212609,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 21,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "Attacks and support using spirit and soul, proud\r\narchery techniques left behind by the noble elves.\r\nI want you to know more about them.",
        "Jp" : "精と霊による攻撃と支援\r\n誇り高いエルフが残した弓術\r\n君にも、もっと知ってほしいわ"
      },
      "MsgSerial" : 212610,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 22,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "Only if you are willing to help us for the\r\nsake of this forest.",
        "Jp" : "君がこの森のため、力を貸してくれるならね"
      },
      "MsgSerial" : 255389,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    } ],
    "NameDispOff" : false,
    "NpcId" : 4502,
    "NpcName" : {
      "En" : "Ringdeel",
      "Jp" : "リングディール"
    }
  }, {
    "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgGroup",
    "GroupNameSerial" : 0,
    "GroupSerial" : 12771,
    "GroupType" : 21,
    "GroupTypeName" : "MSG_GROUP_TYPE_REV_INVALID_CHARGE",
    "MsgData" : [ {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
