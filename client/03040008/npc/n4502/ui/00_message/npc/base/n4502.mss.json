    "MsgData" : [ {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 10,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "I heard about you from Rondejeel.\r\nSounds like you've learned quite a\r\nbit about these woods.",
        "Jp" : "ロンドジ―ルから君のことは聞いたわ\r\nこの森のこと、かなり詳しくなったみたいね"
      },
      "MsgSerial" : 255018,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 11,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "Although I'm a bit late in introducing myself, I\r\nam Ringdeel, a researcher studying the Element\r\nArcher in this land.\r\nWhat do you think? Would you\r\nlike to learn as well?",
        "Jp" : "紹介が遅れたけど、私はリングディール\r\nこの地で《エレメントアーチャー》\r\nについて研究しているの\r\nどう？　君も学んでみない？"
      },
      "MsgSerial" : 255382,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 12,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "\"Element Archer\" is originally a\r\ntechnique of the Elven race.\r\nEven if you're not an elf, you can still use it\r\nif you train like me, so don't worry.",
        "Jp" : "《エレメントアーチャー》はもともと\r\nエルフ族の技なの\r\n私みたいに、修行を積めば\r\nエルフじゃなくても使えるから心配しないで"
      },
      "MsgSerial" : 255383,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 13,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "The Magick Bow and bolts are different from\r\nnormal bows and arrows.\r\nThey harness one's own life force and fly forth—",
        "Jp" : "魔道弓と魔矢は、普通の弓矢とは違うわ\r\n自身の生命力を力とし、放つ――"
      },
      "MsgSerial" : 255384,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 14,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "By focusing your thoughts, magick arrows can\r\nbecome blades that pierce through enemies, or\r\nradiance that protects allies. No matter how many\r\nenemies there are or how many you must protect—",
        "Jp" : "念じることで魔矢は、敵を穿つ刃にも\r\n仲間を守る輝きにもなる\r\nどれほど敵が多く、護るべき者がいようとも――"
      },
      "MsgSerial" : 255385,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 15,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "If you're willing to put in the effort, why not\r\ngive the challenge a try?\r\nI believe you have the potential to master it.",
        "Jp" : "もしその気があるなら課題に挑戦してみて\r\n君なら体得できるんじゃないかな"
      },
      "MsgSerial" : 255386,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    } ],
