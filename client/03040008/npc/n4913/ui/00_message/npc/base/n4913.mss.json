      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "No matter what outfit she wears, Shelly always\r\nradiates a new charm.\r\nYes, it's Ms. Shelly!\r\nShe's the one who can perfectly cover everything,\r\nfrom devilish to innocent girl!",
        "Jp" : "どんな衣装を着ても\r\n新たな魅力を振りまいてくれるのが\r\nそう、シェリーちゃんだ！\r\n小悪魔系から清楚ガールまでただ一人で完全網羅！"
      },
      "MsgSerial" : 816111,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
