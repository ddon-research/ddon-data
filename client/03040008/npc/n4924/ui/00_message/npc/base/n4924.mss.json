    "GroupSerial" : 31550,
    "GroupType" : 83,
    "MsgData" : [ {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 6,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "Letter from [Passion Papyrus] -- You have a lot\r\nof courage to give me this letter, don't you?",
        "Jp" : "《パッションパピルス》の手紙――\r\nあたくしにこの手紙を渡すなんて\r\n勇気があるのね？"
      },
      "MsgSerial" : 819823,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 7,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "Setting aside paper and words— what a lovely poem.\r\nI'm delighted; this poem was crafted\r\nsolely for me, here.",
        "Jp" : "紙や文字はさておいて\r\n――なんてかわいらしい詩なの\r\n嬉しいわ、この詩は\r\nあたくしのためだけに編まれてここにあるのね"
      },
      "MsgSerial" : 819879,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 8,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "There may still be some imperfections, but it's\r\nthe genuine emotion that resonates, more than any\r\noverwhelming technique— Oh, you\r\nunderstand very well.",
        "Jp" : "まだまだつたないところもあるけれど\r\n手に余る技術を駆使するよりも\r\n素直な感性こそが響くというもの――\r\nふふ、よくわかっているじゃない"
      },
      "MsgSerial" : 819880,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 9,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "But if you want to sing better, I can teach you.",
        "Jp" : "でも、もっと上手に歌いたいのなら\r\nあたくしが手ほどきをしてあげてもよくってよ"
      },
      "MsgSerial" : 819881,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 10,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "A beautiful chirp makes even\r\nits wings look better.\r\nLet me enjoy it until the day it takes flight!",
        "Jp" : "美しいさえずりは\r\nその翼をもより良く見せるのですもの\r\n羽ばたきの日まで、楽しませてちょうだい"
      },
      "MsgSerial" : 819883,
