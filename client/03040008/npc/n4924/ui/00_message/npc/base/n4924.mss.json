    }
  }, {
    "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgGroup",
    "GroupNameSerial" : 0,
    "GroupSerial" : 31270,
    "GroupType" : 0,
    "GroupTypeName" : "MSG_GROUP_TYPE_NONE",
    "MsgData" : [ {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 2,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "You mean the paper made from Passion Papyrus?\r\nOf course I know what it is.\r\nIt was all the rage a long time ago.",
        "Jp" : "《パッションパピルス》で作った紙のこと？\r\nもちろん知っているわぁ\r\nかなり前に流行した品ね"
      },
      "MsgSerial" : 816159,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 3,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "It is said to make your thoughts and feelings\r\nreach the other person's heart more strongly.",
        "Jp" : "したためられた想いを\r\nより強く相手の心に届けると言われているわ"
      },
      "MsgSerial" : 819884,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 4,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "However, only those who can wield magick\r\ncan create such things.\r\nThe paper made by the townspeople out of\r\ncuriosity had no such power, so it quickly\r\nfell into obscurity.",
        "Jp" : "もっとも、それは魔術を扱える者が作ったもののみ\r\n町の人が興味本位で作った紙に\r\nそんな力は無いから、すぐに廃れてしまったの"
      },
      "MsgSerial" : 819885,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    } ],
    "NameDispOff" : false,
    "NpcId" : 4924,
    "NpcName" : {
      "En" : "Emerada",
      "Jp" : "エメラダ"
    }
  }, {
    "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgGroup",
