      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 1,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "He, on stage— The moment he entered my abode, He\r\nwas about to prostrate himself.\r\nI wonder if he was that scared.",
        "Jp" : "舞台にいる彼――\r\nあたくしの住まいに来た瞬間に\r\nひれ伏さんばかりだったの\r\nよっぽど怖かったのかしら"
      },
      "MsgSerial" : 816160,
      "MsgType" : 0,
      "SetMotion" : 0,
