    "GroupType" : 41,
    "GroupTypeName" : "MSG_GROUP_TYPE_CRAFT_BLOCK",
    "MsgData" : [ {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 18,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "We have received a report that a group of\r\nAncestor Orcs has gathered at the mountaintop.\r\nThey are extremely primitive Orcs that\r\nreside in the mountains.",
        "Jp" : "山頂にアンセスターオークが群れているとの\r\n報せが入ってきました――\r\nあれらは山に住む、非常に原始的なオークです"
      },
      "MsgSerial" : 652028,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : 14
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 19,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "While their intelligence may be inferior\r\nto that of Dwarf Orcs, in terms of strength,\r\nthey are easily the more dangerous creature.\r\nThey don't usually form such large groups, but...\r\nCould this also be due to the influence\r\nof the Evil Dragon?",
        "Jp" : "知能こそドワーフオークに劣りますが\r\n腕力では寧ろそれを軽々と上回る危険な魔物です\r\n普段はそう大きな群れを作ることは無いのですが――\r\nこれも悪しき竜の影響でしょうか"
      },
      "MsgSerial" : 722867,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : 15
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 20,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "If left alone, they will eventually come down\r\nfrom the mountains to attack this area as well.\r\nWe must scatter the herd as soon as possible!",
        "Jp" : "放っておいては、いずれ山から下りて\r\nこの辺りをも襲撃しに来ることでしょう\r\n一刻も早く、群れを散らしてしまわねばなりません"
      },
      "MsgSerial" : 722868,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : 16
    } ],
    "NameDispOff" : false,
    "NpcId" : 4512,
