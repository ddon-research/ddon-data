    "GroupTypeName" : "MSG_GROUP_TYPE_JM_TUTO_ORDER",
    "MsgData" : [ {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 0,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "Hmph, you the foreign Arisen Razanailt mentioned?",
        "Jp" : "ふん、ラザネイルの言っていた\r\n異国の覚者とは貴様のことか"
      },
      "MsgSerial" : 420255,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 1,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "I don't know how much Razanailt told you, but\r\nI'll introduce myself.\r\nI am Adair Donnchadh.\r\nHere, at the Spirit Arts Hut, I hone my skills\r\nwith the Spirit Lance.",
        "Jp" : "ラザネイルにどこまで聞いたかはしらんが\r\n名乗っておこう、俺はアデルドナハ\r\nこの《武霊の庵》にて、精霊槍の研鑽に努めている"
      },
      "MsgSerial" : 543299,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 2,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "—The Spirit Lance itself\r\nis unfamiliar to those from other lands.\r\nIt is a lancing art that inspires the soul\r\nwith the blessings of all things in the forest,\r\nand heals and guides your companions.\r\nThose who practice this art\r\nare called \"Spirit Lancers.\"",
        "Jp" : "――異国の者には精霊槍自体、馴染みが無いか\r\n森羅万象の加護を得て己を奮い立たせ\r\nそして、仲間を癒し導く槍術のことだ\r\nその槍術を繰る者を《スピリットランサー》という"
      },
      "MsgSerial" : 543300,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 3,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "I have heard that you are dedicating yourself to\r\nthe land of Phindym and its people.\r\nYour spirit befits that of a \"Spirit Lancer.\"",
        "Jp" : "聞けば、貴様はこのフィンダムの地においても\r\n大地と人々のために尽力しているそうだな\r\nその精神は、確かに《スピリットランサー》に\r\nふさわしいと言えるだろう"
      },
      "MsgSerial" : 543301,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 4,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "If you've the aptitude to wield a Spirit Lance, I\r\nmay consider taking you as my disciple— However,\r\nI have no interest in training those who do not\r\npossess the right qualities.",
        "Jp" : "貴様に精霊槍を操る資質があるのならば\r\n俺が弟子にしてやってもいい――\r\nただし、資質に欠ける者を鍛える趣味はない"
      },
      "MsgSerial" : 543302,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 5,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "If you wish to become my disciple, then you must\r\nsuccessfully complete my trials.",
        "Jp" : "弟子入りを望むのであれば\r\n俺のいう試練を見事こなしてみせるのだな"
      },
      "MsgSerial" : 543303,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 6,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "This task is not just for you, but for all\r\nwho wish to apprentice.\r\nThink not ill of it.",
        "Jp" : "これは貴様だけでなく、弟子入りを希望する者\r\n全員に伝えていることだ――悪く思うなよ"
      },
      "MsgSerial" : 543304,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    } ],
    "NameDispOff" : false,
    "NpcId" : 4510,
    "NpcName" : {
      "En" : "Adair Donnchadh",
      "Jp" : "アデルドナハ"
    }
  }, {
    "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgGroup",
    "GroupNameSerial" : 0,
