      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 8,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "I shall take you as my apprentice and teach you\r\nhow to capture the spiritual power that pervades\r\nthe great forest and how to protect your\r\nallies with the lance.",
        "Jp" : "貴様を我が弟子として迎えよう――\r\n森羅へ巡り満ちる霊力を取り込む術、そして\r\n槍を振るうことで仲間を守る術を教え込んでやる"
      },
      "MsgSerial" : 543305,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 9,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "Listen closely, for I shall tell you this.\r\nYou, as a budding Spirit Lancer, have just taken\r\nthe first step towards donning\r\nthe power of spirits.",
        "Jp" : "いいか、よく聞くがいい\r\n貴様はまだ奥深き《スピリットランサー》として\r\n霊力をまとうための第一歩を踏み出したところだ"
      },
      "MsgSerial" : 543306,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 10,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "With further training, the spear will\r\neither dull or sharpen.\r\nIt all depends on your training.",
        "Jp" : "今後の修練によって、その槍は\r\nなまくらにも鋭くもなろう\r\n全ては貴様の鍛練次第ということだ"
      },
      "MsgSerial" : 543307,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 11,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "If you shirk your duty to practice, I shall\r\ncease my instruction.\r\n- Show me well that you constantly strive for\r\nself-discipline and training.",
        "Jp" : "気を抜いているようであれば\r\n俺は何の稽古もつけん\r\n――常に克己して鍛錬に励む様を見せてみろ"
      },
      "MsgSerial" : 543308,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    } ],
