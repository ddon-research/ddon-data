    "GroupType" : 21,
    "GroupTypeName" : "MSG_GROUP_TYPE_REV_INVALID_CHARGE",
    "MsgData" : [ {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 7,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "Well, it seems you have at least some talent.\r\nA gem in the rough that shines when\r\nyou polish it, I guess.",
        "Jp" : "なるほど、最低限の素質はあるようだな\r\n磨けば光る原石、といったところか"
      },
      "MsgSerial" : 420256,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
