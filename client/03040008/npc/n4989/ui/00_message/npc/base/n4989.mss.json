      "DispType" : 0,
      "GmdIndex" : 5,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "Hahaha, you've got a good eye!\r\nWhether it's the appearance or the performance of\r\nequipment, it's up to each individual user to\r\ndecide what they like and use.",
        "Jp" : "ハハハ、お前は見る目があるな！\r\n武具も見た目と性能、どちらを\r\n気に入って使うかは各々の使い手次第"
      },
      "MsgSerial" : 750358,
      "MsgType" : 0,
      "SetMotion" : 0,
