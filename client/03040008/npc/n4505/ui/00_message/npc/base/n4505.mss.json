      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 23,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "The Seeker climbs the treacherous terrain\r\nwith ropes and daggers.\r\nScaling towering enemies with ease, chasing\r\nafter them relentlessly.",
        "Jp" : "シーカーはロープとダガ―で\r\n険しい足場にデカイ魔物、縦横無尽に登って\r\n走ってを追求する奴さ"
      },
      "MsgSerial" : 212765,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 24,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "If you're confident in your agility, then I'm\r\nsure it suits you perfectly!",
        "Jp" : "身ごなしに自信があるなら\r\nきっと合ってると思うぜ！"
      },
      "MsgSerial" : 212766,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 25,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "I genuinely like to climb, but speed, height,\r\nmonsters, treasure...\r\nit's up to the person to decide what\r\nthey want to pursue.",
        "Jp" : "オレは純粋に登るのが好きだけど\r\n速さに高さ、魔物に宝に――\r\n何を追求するかは人次第だな"
      },
      "MsgSerial" : 212767,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
