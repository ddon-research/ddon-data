      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 15,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "To roam the world freely, as one pleases, like\r\npeople who live life on their own terms.",
        "Jp" : "広い世界を自由に、好きなように\r\nオレやあんたみたいにな"
