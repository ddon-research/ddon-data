      "GmdIndex" : 13,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "Yes, \"Seekers\" are more than just climbers.",
        "Jp" : "そうさ\r\n《シーカー》ってのは、単に登るだけ\r\nじゃないんだぜ"
      },
