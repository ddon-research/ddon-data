      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 16,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "Now, wield those ropes and daggers as you please,\r\nreaching for your target however you see fit!",
        "Jp" : "さぁ、これからはそのロープとダガ―を\r\n思うがまま、お前の目的めがけて\r\n振るってやればいいさ！"
      },
      "MsgSerial" : 190497,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    } ],
    "NameDispOff" : false,
    "NpcId" : 4505,
