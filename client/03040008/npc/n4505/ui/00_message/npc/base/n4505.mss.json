      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "Whoa!　That's good, that's good, that's good!\r\nYou're really starting to get it, aren't you?",
        "Jp" : "おっ！　いいねぇいいねぇ！\r\nあんた、解ってきたみたいじゃないか"
