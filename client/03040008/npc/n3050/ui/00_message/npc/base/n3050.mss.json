      "DispType" : 0,
      "GmdIndex" : 12,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "Hehe, now— Yes, it's something to be\r\nhonestly happy about!",
        "Jp" : "ふふ、今は――\r\nええ、素直に嬉しいものです！"
