      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "The art of Priest, is a healing\r\nart that affects life.\r\nIts power is not limited to healing the wounds of\r\ncomrades in battle, but goes beyond.",
        "Jp" : "《プリースト》の術は\r\n生命に働きかける癒しの術――\r\nその力は戦いの中で、仲間の傷を\r\n治すだけではありません"
      },
      "MsgSerial" : 211304,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
