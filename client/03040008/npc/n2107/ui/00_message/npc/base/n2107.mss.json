      "GmdIndex" : 14,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "An enormous monster with a strong vitality.\r\nWhen such a being gets angry and loses control,\r\nthey are able to sense the vital spot where\r\nvitality gathers, the \"Secret Core\".",
        "Jp" : "強い生命力を持った巨大な魔物\r\nそういった存在が怒り、気を乱した時\r\n生命力の集まる急所\r\n《シークレットコア》を感知することもできるのです"
      },
      "MsgSerial" : 375424,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
