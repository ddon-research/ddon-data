    }
  }, {
    "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgGroup",
    "GroupNameSerial" : 0,
    "GroupSerial" : 13963,
    "GroupType" : 43,
    "GroupTypeName" : "MSG_GROUP_TYPE_REGISTERD_ENTRY_TALK",
    "MsgData" : [ {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 1,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "I see, So that's the story.\r\nI am Camus, and I am here in this cathedral\r\nto heal and guide you.",
        "Jp" : "なるほど――\r\nそのお話ですか\r\n私はカミュ、この聖堂で癒しと導きをしております"
      },
      "MsgSerial" : 255015,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 2,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "As a Priest, you already seem to have\r\ngained some experience.\r\nNow, I have only one important thing to tell you:",
        "Jp" : "《プリースト》としてすでに貴方は\r\n多少経験を積まれている様子\r\nでは、私からは大きな話をひとつだけ"
      },
      "MsgSerial" : 255327,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 3,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "Though there are many professions, only the\r\n\"Priest\" specializes in recovery techniques.\r\nPraying for miracles, they can heal\r\nthrough the power of time.",
        "Jp" : "職は数あれど奇跡を祈り\r\n回復の技を主とするは《プリースト》のみ――"
      },
      "MsgSerial" : 255328,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 4,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "Who will you heal and who will you aid— Your\r\ndecision will greatly affect the war situation!",
        "Jp" : "誰を癒やし、誰を援助するのか――\r\n貴方の判断が戦況を大きく左右します"
      },
      "MsgSerial" : 255329,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 5,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "According to the situation, you may come to\r\nconsider yourself as the ruler of the battlefield.\r\nOf course, that is a great mistake.",
        "Jp" : "ことによると、貴方は、自分自身を\r\n戦場の支配者だと考えるようになるかもしれません\r\nもちろん、それは大いなる間違いです"
      },
      "MsgSerial" : 255330,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 6,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "To serve the people and thrive within their\r\nmidst— Assessing the allies and even the enemies'\r\nConditions, Guiding the battle to its resolution—",
        "Jp" : "人々に尽くし、その中で己を活かす――\r\n味方、そして敵の状況をも見極め\r\n戦いを終結に導く――"
      },
      "MsgSerial" : 255331,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 7,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "That is our mission as Priests.",
        "Jp" : "それこそが我々《プリースト》の使命なのです"
      },
      "MsgSerial" : 255332,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 8,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "It seems that you have the aptitude\r\nto be a good healer.\r\nIf you wish to pursue further on the path of\r\nhealing, I would be delighted to\r\nlend a helping hand.",
        "Jp" : "貴方には良き癒し手としての素養があるようです\r\nさらなる癒しの道を歩もうと望むのであれば\r\n私は喜んで力添えをいたしましょう"
      },
      "MsgSerial" : 255333,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    } ],
    "NameDispOff" : false,
    "NpcId" : 2107,
    "NpcName" : {
      "En" : "Camus",
      "Jp" : "カミュ"
    }
  }, {
    "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgGroup",
