      "GmdIndex" : 2,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "I have been greatly indebted to you in\r\nmany ways, Lady Carrie.\r\nI am truly grateful to you.",
        "Jp" : "いろいろと世話になりやしたね\r\nキャリーの姐さんには\r\n感謝してます"
