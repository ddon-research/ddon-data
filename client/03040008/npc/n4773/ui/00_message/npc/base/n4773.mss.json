      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 10,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "\"Lightweight, comfortable, and easy to wear.\"",
        "Jp" : "「軽くて楽で履きやすい」"
