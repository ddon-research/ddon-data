      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 3,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "Oops!\r\nOf course, even to you, Ser Arisen!",
        "Jp" : "おっと！\r\nもちろん覚者さんにも！"
      },
      "MsgSerial" : 674221,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 4,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "The rumor of the resurrected Grand Dining Hall\r\nhas even become a topic among our band of bandits.\r\nSome of us have already gone to eat there.",
        "Jp" : "復活した大食堂の噂\r\n俺ら盗賊団でも話題ですぜ\r\nさっそく食べに行ったやつもいるほどで"
      },
      "MsgSerial" : 674222,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 5,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "I would like to show my face at least once, but\r\nunfortunately, I've been given a\r\nmountain of tasks to do.",
        "Jp" : "一度くらい顔出したいとこなんですがね\r\nあいにく、用事を山ほど言いつけられちまって"
      },
      "MsgSerial" : 674223,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 6,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "I would like to say it directly, but...\r\nPlease give my regards to Carrie, Ser.",
        "Jp" : "本当は直接言いたいところですが――\r\nキャリーの姐さんに\r\nよろしく言っておいてくだせぇ"
      },
      "MsgSerial" : 674225,
      "MsgType" : 0,
