      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 9,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "Naturally, we are also very particular\r\nabout our \"footwear\".",
        "Jp" : "当然、\"履物\"にも\r\n並々ならぬこだわりを持ってやしてね"
      },
