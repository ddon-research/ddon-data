      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 8,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "\"Fast—quiet—before you know it.\" That's my motto.",
        "Jp" : "\"速く――静かに――いつの間にか\"\r\nこれが俺のモットーでして"
      },
      "MsgSerial" : 675195,
