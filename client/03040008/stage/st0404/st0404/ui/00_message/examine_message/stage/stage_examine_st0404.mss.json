    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 6,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "Though we elves live much longer than humans, \r\nsurely each species has its role \r\nthat fits its lifespan.",
        "Jp" : "我々エルフより、人の一生ははるかに短いが\r\nそれぞれの種にはおそらく、生きる時間に\r\n見合った役割があるのだろう"
      },
      "MsgSerial" : 214404,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 1,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 7,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "Just as humans cannot perceive long spans \r\nof time with a single glance, we find it \r\ndifficult to swiftly grasp the changes \r\nthat can occur in a short time.",
        "Jp" : "人が長い時間をひとつの目で見られないのと\r\n同様に、我々は短い時間に起こりえる変化を\r\n素早く捉えることは難しい"
      },
      "MsgSerial" : 214407,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 1,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 8,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "The transient and the steadfast,\r\nboth are equally necessary for the flow of the world.",
        "Jp" : "移ろう者と、とどまる者\r\n世の流れにはそのどちらもが等しく必要なのだ"
      },
      "MsgSerial" : 214410,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 1,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 9,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "Thus, the one chosen by the White Dragon, \r\nthe Arisen, can be called the next weaver \r\nof both.",
        "Jp" : "そして、白竜が選んだ者《覚者》こそ、その両方\r\nを備える次代の紡ぎ手と言えるだろう"
      },
      "MsgSerial" : 214431,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 1,
      "VoiceReqNo" : -1
    } ],
