      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "\"Elves and Humans\"",
        "Jp" : "\"エルフと人\""
      },
      "MsgSerial" : 207066,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 1,
