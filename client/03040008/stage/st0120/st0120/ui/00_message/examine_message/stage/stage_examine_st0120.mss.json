    "GroupTypeName" : "MSG_GROUP_TYPE_NONE",
    "MsgData" : [ {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 3,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "\"A page out of a diary has fallen down.\"",
        "Jp" : "\"日記の１ページが落ちている\""
      },
      "MsgSerial" : 578793,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 1,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 4,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "It is a surprising discovery! I had no idea that\r\nPixies had built such a high level of social\r\nhierarchy - and moreover, its strength is greater\r\nthan that of the commonly compared Goblin.",
        "Jp" : "驚くべき発見です！\r\nピクシーが、これほど高度な社会的序列を築いて\r\nいたとは――しかも、その強固さは\r\n比較対象にされることの多いゴブリン以上"
      },
      "MsgSerial" : 578796,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 1,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 5,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "Mr. Benjamin seemed to be in an unusually good\r\nmood and, by golly... he told us a little about\r\nhimself!",
        "Jp" : "ベンジャミン様はいつになくご機嫌が良いようで\r\nなんと――ご自分のことを\r\n少し話してくださいました！"
      },
      "MsgSerial" : 578799,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 1,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 6,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "First and foremost, I pay my respects to my late\r\ncomrade, the only friend of a Phindymian. I\r\ncontinue my journey in tribute to his aspirations\r\nand in mourning.",
        "Jp" : "まず、亡きご友人について\r\nフィンダム人唯一の友人であること――\r\n彼の志に敬意を表し、弔いの旅を続けていること――"
      },
      "MsgSerial" : 578802,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 1,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 7,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "Furthermore, once our journey comes to a conclusion,\r\nI wish to establish a gathering of adventurers\r\nto ensure that such events never happen again,\r\nand to foster mutual assistance in the future.",
        "Jp" : "さらに、旅が終わったら二度と\r\nこのようなことが起きないよう\r\n冒険者の集いを作り、助け合えるように\r\nしたいということ"
      },
      "MsgSerial" : 578805,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 1,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 8,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "And what had moved me the most was that\r\nwe were allowed to play a part in it as well.\r\nEven as pawns, it felt like we were recognized\r\nas companions on equal footing.",
        "Jp" : "そして最も感動したのは、我々にも\r\nその一端を担わせてくださるということ――\r\nポーンでありながら仲間として認められた\r\nような気さえしました"
      },
      "MsgSerial" : 578808,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 1,
      "VoiceReqNo" : -1
    } ],
