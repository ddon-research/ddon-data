      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "I see that there is something on your mind.\r\nI was just thinking that I would like to hear\r\nabout the ideal form of the Myrmidons that you,\r\nLord, envision. When it suits your mood, please\r\nring the bell in your room to summon me.",
        "Jp" : "――何か思うところがあるのですね\r\n私もちょうど、主殿の理想とする戦徒の姿について\r\n自室でゆっくりと伺いたい、そう思っていたのですよ\r\n主の気の向くとき、自室のベルでお呼びください"
      },
      "MsgSerial" : 2989,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 1,
      "VoiceReqNo" : -1
    } ],
    "NameDispOff" : false,
