      "GmdIndex" : 1,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "Could you slay the Ent that appeared in the\nAncient Ritual Grounds?",
        "Jp" : "《古の祭祀場》に現れたという\nエントを討伐してくれないかしら"
