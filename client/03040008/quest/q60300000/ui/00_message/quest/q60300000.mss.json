      "GmdIndex" : 1,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "There are several ways to renovate your private quarters.\r\nShall we discuss which method \r\nsuits you best, Ser Arisen?",
        "Jp" : "自室を改築するためには\r\n何通りかの方法がありましてな\r\nどの方法が覚者さまに合うか、ご相談させて\r\nいただけませんかな？"
      },
      "MsgSerial" : 619982,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
