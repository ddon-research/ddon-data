      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 3,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "However, I cannot guarantee the carpenter's skill.\r\nYou'll need to provide extra materials,\r\nand allow ample time for the work to be completed.",
        "Jp" : "ただし、大工の腕までは保証できません\r\n素材は少し多めに納品していただき、\r\n作業時間もゆとりを見て取らねばなりません"
      },
      "MsgSerial" : 619983,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
