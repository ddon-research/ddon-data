      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 1,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "Speaking of which, in the ransacked \r\n<STG 448>,\r\nI saw a girl was crouching, \r\nall color gone from her face.\r\nI wanted to help, but unfortunately\r\nwas swamped myself...",
        "Jp" : "そういえば、荒らされた《<STG 448>》で\r\n女の子が真っ青な顔でうずくまっていました\r\n手を貸したかったのですが、あいにく\r\n私も手一杯でして――"
      },
      "MsgSerial" : 630703,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 2,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "Master Arisen, could you go and\r\ncheck on her for me?",
        "Jp" : "覚者さま、一度様子を見にいって\r\nやっていただけませんか？"
      },
      "MsgSerial" : 630704,
      "MsgType" : 0,
      "SetMotion" : 0,
