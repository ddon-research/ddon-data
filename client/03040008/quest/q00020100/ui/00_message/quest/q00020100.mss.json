      "DispType" : 0,
      "GmdIndex" : 24,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "Understood.\r\nYou must have your own circumstances,\r\nso my burgeoning curiosity\r\nwill be fulfilled by my own methods.",
        "Jp" : "いいでしょう\r\n貴方にも事情がおありでしょうからね\r\n私に芽生えた好奇心は\r\n私のやり方で満たさせて頂きますよ"
      },
      "MsgSerial" : 377205,
