    "GroupType" : 0,
    "GroupTypeName" : "MSG_GROUP_TYPE_NONE",
    "MsgData" : [ {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 18,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "So, you've recently gained subordinates\r\nand are thriving as a captain. I've heard this\r\nthrough the grapevine. Now, about today...",
        "Jp" : "最近、部下を得て隊長としてご活躍とのこと\r\n風の便りで聞いております\r\nさて、今日は――"
      },
      "MsgSerial" : 377196,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
