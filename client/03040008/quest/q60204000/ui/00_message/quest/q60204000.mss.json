      "GmdIndex" : 10,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "We can now gather miners and proceed with the\r\nredevelopment of the Volden Large Tunnels.\r\nThank you as always, Ser Arisen!",
