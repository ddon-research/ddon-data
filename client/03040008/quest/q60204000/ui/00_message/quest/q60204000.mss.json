      "GmdIndex" : 7,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "You know, the one about a skeletal knight\r\nwandering the mines...",
        "Jp" : "ほら、アレです\r\n骸骨騎士が坑道をうろついているとかいう噂――"
      },
      "MsgSerial" : 482185,
