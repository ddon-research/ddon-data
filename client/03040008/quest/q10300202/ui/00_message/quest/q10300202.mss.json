      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 3,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "Hmm... I definitely want to fix it...",
        "Jp" : "うぅん――\r\nやっぱり直したいなぁ――"
      },
      "MsgSerial" : 674950,
      "MsgType" : 0,
