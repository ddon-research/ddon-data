    "GroupTypeName" : "MSG_GROUP_TYPE_NONE",
    "MsgData" : [ {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 14,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "You don't seem surprised to see me... \r\nInteresting. \r\nYou were directed here by someone \r\nwho'd previously seen me?",
        "Jp" : "私を見ても驚かないのですね\r\n――ほう、私を目撃した人間からの情報で\r\nここに来たと言うわけですか"
      },
      "MsgSerial" : 745053,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 15,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "As you can see, I'm not among the living. \r\nI wander the world—call it lingering will. \r\nTo put it bluntly, I'm a \"ghost.\"",
        "Jp" : "見ての通り、私は生きた人間ではありませぬ\r\n世界のあちこちを彷徨っている\r\n執念のようなものです\r\n有体に言えば――\"幽霊\"です"
      },
      "MsgSerial" : 745054,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 16,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "Curious about this weapon? \r\nI see... \r\nThis continent has no job called High Scepter.",
        "Jp" : "この武器が気になると？\r\n――なるほど、この大陸には\r\n《ハイセプター》というジョブは無いのですね"
      },
      "MsgSerial" : 745055,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 17,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "Looking at you, I sense you have a special talent.",
        "Jp" : "私が見るに、貴方はどうやら\r\n特別な資質をお持ちのようだ"
      },
      "MsgSerial" : 745056,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 18,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "With those qualities, you may wield \r\na sword as a High Scepter someday.\r\n...Then, if fate allows, we'll meet again.",
        "Jp" : "その資質があれば、いつか《ハイセプター》として\r\n剣を振るうことがあるかもしれませんね\r\n――それでは、縁があればまた会いましょう"
      },
      "MsgSerial" : 751729,
      "MsgType" : 0,
      "SetMotion" : 0,
