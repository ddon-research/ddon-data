      "GmdIndex" : 7,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "Ah, you made it back safely.\r\nDid you find the person I mentioned?",
        "Jp" : "ああ、無事に戻ったか\r\n俺が言った人物は見つかったか？"
      },
      "MsgSerial" : 680683,
      "MsgType" : 0,
      "SetMotion" : 0,
