      "DispType" : 0,
      "GmdIndex" : 20,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "I drift where fate takes me. \r\nTill we meet again—whenever that may be.",
        "Jp" : "私は流浪の存在\r\n縁があれば、またお会いすることでしょう\r\nそれでは、その日まで――"
      },
      "MsgSerial" : 745058,
      "MsgType" : 0,
