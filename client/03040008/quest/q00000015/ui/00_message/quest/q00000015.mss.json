      "GmdIndex" : 23,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "With the White Dragon's divine protection, \r\nit thrived as the cultural heart of Lestania.",
        "Jp" : "白竜様の特別なご加護もあって\r\nレスタニアの文化の都として栄えたんだ"
      },
      "MsgSerial" : 162056,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
