      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 26,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "From what people say, \r\nthe city's former beauty has all but vanished― \r\nand the hatred for the orcs only continues to grow―",
