      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "I heard that Erte Deenan was a very \r\nbeautiful city, beloved by the people.",
        "Jp" : "《エルテ・ディナン》は住民に愛された\r\nとても美しい都だったと聞いているよ"
      },
      "MsgSerial" : 20666,
      "MsgType" : 0,
      "SetMotion" : 0,
