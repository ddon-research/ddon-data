    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 1,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "I'm going on an expedition to Erte Deenan.\r\nI want you to join me.",
        "Jp" : "《エルテ・ディナン》に遠征する\r\nおまえも参加してくれ"
      },
      "MsgSerial" : 162042,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 2,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "Certainly, \r\nthat elf scoundrel hunted by the orcs—",
        "Jp" : "もちろん、オークどもに狙われている\r\nエルフ野郎――"
      },
      "MsgSerial" : 162043,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 3,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "The purpose is to support Kieshildt.",
        "Jp" : "キースヒルトの援護が目的だ"
      },
      "MsgSerial" : 162044,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 4,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "He might find it bothersome, \r\nbut it's uncomfortable to always be on \r\nthe receiving end of help.",
        "Jp" : "あいつは迷惑に思うだろうが\r\n世話になりっぱなしでは居心地が悪い"
      },
      "MsgSerial" : 162045,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 5,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "The fact that there are no orcs here is \r\ndefinitely his doing, but reducing our strength \r\nhere isn't my intention.",
        "Jp" : "ここにオークがいないのは\r\nまぎれもなくあの男のおかげだ\r\nしかし、ここの戦力を減らすのは本意ではない"
      },
      "MsgSerial" : 162046,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 6,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "It's just us, tied to Kieshildt, \r\ntackling this matter with a select few.",
        "Jp" : "キースヒルトに縁のある俺とおまえ――\r\nごく少数で事に当たる"
      },
      "MsgSerial" : 162047,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 7,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "We'll leave as soon as we're ready.\r\nI'll meet you over there.",
        "Jp" : "準備ができしだい出発する\r\n向こうで合流しよう"
