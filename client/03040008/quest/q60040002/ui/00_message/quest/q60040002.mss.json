    "MsgData" : [ {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 5,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "As expected, Ser Arisen!\nA splendid defeat of the Griffin.\nIt was certainly no match for you.",
        "Jp" : "おお、さすがは覚者さん！\n大ワシ討伐、お見事です\nさすがのグリフィンも成敗されたようですな"
      },
      "MsgSerial" : 286208,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 6,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "However, we found further activity at the nest site,\nso there seems to be more than one griffin using it.",
        "Jp" : "しかし、あの巣についてこっちでも状況を\n調べていたんですが\nどうもあそこを巣にしてるグリフィンは\n１頭ではないようでして"
      },
      "MsgSerial" : 286209,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 7,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "Though you've graciously slain one, Arisen,\nanother griffin may later decide to fly in.\nShould that come to pass, we trust you\nto handle the matter favorably.",
        "Jp" : "覚者さんが退治されたのと別のグリフィンが\nまた飛来するかもしれません\nその時はまた、よしなに――"
      },
      "MsgSerial" : 286212,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 8,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "Although with that said, a Griffin's penchant\nfor collecting shiny things could turn into\na profitable business, if done right.",
        "Jp" : "しかしあれですなぁ\nグリフィンの光りモノ収集癖、\nうまくやれば良い商売になりそうですな"
      },
      "MsgSerial" : 286213,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    } ],
