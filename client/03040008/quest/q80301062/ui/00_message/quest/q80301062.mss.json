      "DispType" : 0,
      "GmdIndex" : 17,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "If we can handle those foes,\r\nI'll be fine on my own after that.",
        "Jp" : "奴らさえなんとかなれば後は一人で大丈夫だ"
      },
      "MsgSerial" : 660493,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 18,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "Inform Master Sonel that \"the info\"\r\nhas been acquired! I'll be back shortly—thanks!",
        "Jp" : "ソネル様に「\"例の情報\"が手に入った」\r\nと伝えてくれ！\r\n俺もすぐ戻る――ありがとよ！"
      },
      "MsgSerial" : 711312,
      "MsgType" : 0,
