      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "I see, the enemies are pursuing us—\r\nthey must be quite desperate.\r\nIt was wise to ask the captain.",
        "Jp" : "そうか、敵の追っ手に――\r\n奴らも相当必死ということか\r\n隊長に頼んで正解だったよ"
      },
      "MsgSerial" : 660515,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
