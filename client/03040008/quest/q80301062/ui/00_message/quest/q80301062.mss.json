      "DispType" : 0,
      "GmdIndex" : 2,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "Considering the circumstances, \r\nI want you to join me too, Captain.",
        "Jp" : "事が事だからね\r\n隊長にも一緒に来てほしい"
