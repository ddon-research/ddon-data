      "GmdIndex" : 0,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "Ah, Captain!\r\nI was just sending you a telepathic message!",
        "Jp" : "あ、隊長！\r\n今、テレパシーを送っていたところさ！"
      },
      "MsgSerial" : 660468,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
