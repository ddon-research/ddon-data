      "DispType" : 0,
      "GmdIndex" : 16,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "You're quite skilled!\r\nAs expected from someone\r\nsent by Master Sonel; I'm impressed.",
        "Jp" : "あんた腕が立つんだな！\r\nさすが、ソネル様が寄越しただけのことはある\r\n驚いたよ"
      },
      "MsgSerial" : 660492,
      "MsgType" : 0,
