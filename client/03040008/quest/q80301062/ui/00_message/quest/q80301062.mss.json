      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 20,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "Alright! Now that we have the information\r\nhe brought back and the soil to study,\r\nwe should be able to \"cultivate\" that!",
        "Jp" : "よし！　彼が持ち帰った情報と\r\n研究中の土が完成すれば\r\nアレの\"品種改良\"が可能なはずさ"
      },
      "MsgSerial" : 660516,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
