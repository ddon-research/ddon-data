    "GroupSerial" : 26678,
    "GroupType" : 0,
    "GroupTypeName" : "MSG_GROUP_TYPE_NONE",
    "MsgData" : [ {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 4,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "Hey. I've been waiting, Captain. \r\nThe truth is, I asked a friend to \r\ngather some information for me—",
        "Jp" : "やぁ、待ってたよ、隊長\r\n実はね、ある情報の収集を頼んでいた\r\n友人がいるんだが――"
      },
      "MsgSerial" : 660471,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 5,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "He hasn't come back since yesterday. \r\nThere has never been a delay without \r\ncontacting me before.",
        "Jp" : "彼が昨日から戻って来ないんだ\r\n今まで何の連絡もなしに\r\n予定より遅れることはなかった"
      },
      "MsgSerial" : 660472,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 6,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "It's likely he was caught up in something—\r\nI managed to gather that he was last seen\r\naround this area, but that's about it.",
        "Jp" : "途中で、何かに巻き込まれた可能性が高い――\r\n最後に目撃されたのがこの辺りだと\r\nいうことまでは掴んだんだけど"
      },
      "MsgSerial" : 660473,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 7,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "If things go wrong, \r\nthis is where we agreed to meet, \r\nso I must stay here.",
        "Jp" : "もしもの時は――\r\nここで落ち合うことにしてるから\r\nボクはここに残らないといけない"
      },
      "MsgSerial" : 711307,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 8,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "I'm sorry, but I need you to go \r\nto where the captain was last seen.",
        "Jp" : "すまないが、隊長は\r\n最後に目撃された場所へ向かって欲しい"
      },
      "MsgSerial" : 711308,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 9,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "You're the only one I can rely on for this. \r\nI know it's a bother, but I'm trusting you.",
        "Jp" : "こんなことを頼めるのは隊長しかいないんだ\r\n厄介をかけるけど、頼んだよ"
      },
      "MsgSerial" : 711309,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    } ],
