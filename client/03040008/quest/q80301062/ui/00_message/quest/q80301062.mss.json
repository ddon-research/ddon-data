      "DispType" : 0,
      "GmdIndex" : 1,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "There's something troubling me, \r\nso I'm thinking of going to \r\n<STG 1001>.",
        "Jp" : "ちょっと困ったことがあってね\r\n<STG 1001>へ行こうと思うんだ"
