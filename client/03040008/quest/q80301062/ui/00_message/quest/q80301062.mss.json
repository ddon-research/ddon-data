      "GmdIndex" : 14,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "I got the information, \r\nbut I was assaulted by enemies, \r\nand now I'm in this state...",
        "Jp" : "情報を手に入れたはいいが\r\n敵に襲われてこのザマだ――"
