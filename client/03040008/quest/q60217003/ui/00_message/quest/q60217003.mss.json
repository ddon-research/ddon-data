      "GmdIndex" : 15,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "After all, powerful monsters prowl there —\r\nit's all but their den.\r\nBut — you'd take it on, then?",
        "Jp" : "何せ、強力な魔物が徘徊し\r\nその根城としているような場所だ\r\nしかし――貴君は引き受けてくれるというのだな"
      },
      "MsgSerial" : 552596,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
