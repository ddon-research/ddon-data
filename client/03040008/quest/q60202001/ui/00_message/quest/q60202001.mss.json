    "MsgData" : [ {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 7,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "Ser Arisen, how fared the Lindwurm?\r\nAny sign it meant to make for the village—\r\nEh! You went and slew it?!",
        "Jp" : "覚者さん、リンドブルムの様子はどうだった？\r\n村の方に来そうな気配は――\r\nえっ！　やっつけてきてくれたのか！？"
      },
      "MsgSerial" : 446126,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 8,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "W-well, that's a mighty relief, aye!\r\nBut even the Lindwurm — once it's been thrashed\r\nby Ser Arisen, it'll think twice afore nearing\r\nthe village anew, I warrant.",
        "Jp" : "そ、そりゃおかげで安心したけどさ！\r\nリンドブルムだって、覚者さんに\r\nとっちめられたとなれば、今後も村の方に\r\n近寄ろうとはしないだろうからね"
      },
      "MsgSerial" : 481977,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 9,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "'Tis a weight off — with Ser Arisen about,\r\nRotes'll surely be safe from here on! Take this,\r\nas thanks. 'Tis a small thing, but may it serve.",
        "Jp" : "ふぅ、覚者さんがいてくれれば\r\nきっとこれからもローテスは安泰だよ！\r\nこれ、今回のお礼だよ\r\n少ないけど役に立ててくれ"
      },
      "MsgSerial" : 481978,
