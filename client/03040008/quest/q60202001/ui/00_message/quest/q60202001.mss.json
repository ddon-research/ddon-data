      "DispType" : 0,
      "GmdIndex" : 4,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "Should the Lindwurm of Moltova Ruins show the\r\nleast sign of making for this side—\r\nsend word of it right away.",
        "Jp" : "《モルトバ遺跡》のリンドブルムが\r\nもしこっちに来るようなそぶりを見せていたら\r\nすぐに教えてくれ"
      },
      "MsgSerial" : 446125,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 5,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "As Area Master, I must devise some recourse—\r\nevacuate the villagers, mayhap...",
        "Jp" : "エリアマスターとして、村人を避難させるとか\r\n何か方法を考えないと――"
      },
      "MsgSerial" : 481907,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 6,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "Ugh, this is weighing on me...\r\nCould you please go\r\ncheck it out as soon as possible...?",
        "Jp" : "うう、気が重いよ――\r\nできるだけ早く見に行ってもらえないかな――"
      },
      "MsgSerial" : 481910,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    } ],
    "NameDispOff" : false,
    "NpcId" : 1205,
    "NpcName" : {
      "En" : "O'Neill",
