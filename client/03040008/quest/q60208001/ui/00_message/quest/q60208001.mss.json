      "DispType" : 0,
      "GmdIndex" : 7,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "Oh, thank the Dragon, you're back safe!\r\nI am truly, truly gladdened!",
        "Jp" : "おお、無事に帰ってきてくれてよかった！\r\nほんっとうによかった！"
      },
      "MsgSerial" : 446220,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
