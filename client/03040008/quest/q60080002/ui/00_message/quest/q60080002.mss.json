      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "Hey, how did it go at the War Demons'\nHideout?",
        "Jp" : "おお、どうだった！？　\n《戦鬼の影穴》は――"
      },
      "MsgSerial" : 286375,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
