      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "I'm truly sorry for always asking \nyou to do such dangerous work.",
        "Jp" : "ほんと、いつも危ない仕事ばかり\n頼まれてもらって悪いな"
      },
      "MsgSerial" : 286369,
