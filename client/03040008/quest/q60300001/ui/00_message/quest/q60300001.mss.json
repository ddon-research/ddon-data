    "GroupTypeName" : "MSG_GROUP_TYPE_NONE",
    "MsgData" : [ {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 8,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "Hehehe...\r\nI'm glad you asked.",
        "Jp" : "フフフ――\r\nよくぞ聞いてくれたね"
      },
      "MsgSerial" : 593600,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 9,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "Do you know about Mandragoras? \r\nSome Arisen brought them back from Phindym, \r\nshocking the botanical and zoological societies \r\nof Lestania—those cute little roots!",
        "Jp" : "君は、《マンドラゴラ》って知ってるかい？\r\n一部の覚者がフィンダムから持ち帰ったことで\r\nレスタニアの植物学会・動物学会を\r\n大震撼させたあのキュートな根っこのことさ！"
      },
      "MsgSerial" : 614893,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 10,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "I study them, but alone, I can only do so much. \r\nI was looking for a sunny, spacious place to \r\nraise them—then I heard about you.",
        "Jp" : "僕、あの子たちを研究しているんだけど\r\nやっぱり一人じゃ限界があるだろう？\r\n日当たり良くのびのびと育てられる環境――\r\nそんな所を探していたら、君の噂を聞いたのさ"
      },
      "MsgSerial" : 616713,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 11,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "So, I wanted you to try raising them! \r\nThat's why I brought them today. \r\nLook, here―",
        "Jp" : "だから、ぜひ君に育ててみてもらいたくて\r\n今日は連れて来たんだよ！\r\nほら、ここに――"
      },
      "MsgSerial" : 629330,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 12,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "—Huh? Wait, where did they go!?",
        "Jp" : "――あれ\r\nちょっとちょっと、どこ行ったんだい！？"
      },
      "MsgSerial" : 629331,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 13,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "—Unbelievable! \r\nYou didn't see a Mandragora, did you?",
        "Jp" : "――信じられないよ！\r\n君、マンドラゴラを見なかった！？"
      },
      "MsgSerial" : 630430,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 14,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "Perhaps... it got lost while I was investigating\r\nthe animals around the temple.",
        "Jp" : "もしかして――\r\n神殿の周りの動物を調べているときに\r\nはぐれちゃったのかも"
      },
      "MsgSerial" : 630431,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 15,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "Hey, you know this area well, right? \r\nCould you—please go look for it? \r\nIt can't have gone far.",
        "Jp" : "ねぇ君、この辺りは詳しいんだろう？\r\n悪いんだけど――探してきてくれよ！\r\nきっとまだ、そう遠くへは行ってないはずだ"
      },
      "MsgSerial" : 630432,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 16,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "Mandragora usually hides underground,\r\nbut often leaves traces in nearby bushes.\r\nCheck every suspicious spot one by one.\r\nThey should pop out in surprise!",
        "Jp" : "マンドラゴラは普段、地中に隠れているけど\r\n周りの茂みなんかに痕跡を残すことが多いんだ\r\n怪しい場所は片っ端から調べてみてね\r\n驚いて出てくるはずだよ！"
      },
      "MsgSerial" : 630433,
      "MsgType" : 0,
