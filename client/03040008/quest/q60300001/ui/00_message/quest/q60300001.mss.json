      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "You must be the master of this lovely room. \r\nI'm Aidas—pleased to meet you.",
        "Jp" : "君がこの素敵な部屋の主だね\r\n僕はエイダス――\r\nお初にお目にかかるよ"
