      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "You'll see it done, then? Very well — let\r\nme explain anew.",
        "Jp" : "やってくれるんだね\r\nではあらためて説明しておくよ"
      },
      "MsgSerial" : 286265,
