      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 50,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "Only one who has fulfilled the wishes of \r\nLestania's people and brought joy is worthy of \r\nholding it. \r\nNow, this is another Christmas gift for you. \r\nPlease, accept it.",
        "Jp" : "これを持つのは、レスタニアの民の願いを叶え\r\n幸せを運んだ者こそがふさわしい――\r\nさぁ、君へのもう一つのクリスマスプレゼントだ\r\nどうか受け取ってくれ"
      },
      "MsgSerial" : 704987,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 51,
      "JumpGroupSerial" : 0,
