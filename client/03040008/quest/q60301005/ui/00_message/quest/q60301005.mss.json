      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 46,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "I've got something for you, though I hesitate to \r\ncall it a reward. How about a strange stone I \r\nfound while exploring a dungeon the other day? \r\nYou've always liked odd things, right?",
        "Jp" : "そうだ、お駄賃と言ってはなんだが\r\nこの前ダンジョンの開拓中に見つけた\r\n変わった石をお前にやろうか\r\nこういう変わった物、好きだったよな？"
      },
      "MsgSerial" : 712944,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    } ],
    "NameDispOff" : false,
    "NpcId" : 550,
    "NpcName" : {
      "En" : "Isaac",
      "Jp" : "アイザック"
    }
  }, {
    "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgGroup",
