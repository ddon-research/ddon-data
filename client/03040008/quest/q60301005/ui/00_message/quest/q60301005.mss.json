      "GmdIndex" : 49,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "Ah, yes, indeed. \r\nThe fragment of the falling star from earlier \r\nhas been restored to a whole star once more.",
        "Jp" : "おお、そうだそうだ\r\n先ほどの流れ星の欠片だが\r\nこの通り元の一つの星になったぞ"
      },
      "MsgSerial" : 704986,
      "MsgType" : 0,
