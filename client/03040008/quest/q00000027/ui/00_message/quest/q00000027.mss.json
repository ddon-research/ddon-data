      "DispType" : 0,
      "GmdIndex" : 2,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "I've been searching for a way to stop\r\nthe petrification of the White Dragon,\r\nor at least improve its condition, \r\nwithout relying on the \"Blood Orb.\"",
        "Jp" : "おれは《ブラッドオーブ》に頼らずに\r\n白竜の石化を食い止める――\r\nあるいは症状を改善する方法を探していた"
      },
      "MsgSerial" : 254293,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
