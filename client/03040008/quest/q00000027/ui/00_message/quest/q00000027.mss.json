      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "Does the name Gilstan ring a bell?",
        "Jp" : "ギルスタンという名に聞き覚えはあるか？"
      },
      "MsgSerial" : 93110,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
