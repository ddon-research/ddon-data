      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 3,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "Blood Orbs may be rare, but it's hard to say\r\nthat its effects are significant.",
        "Jp" : "《ブラッドオーブ》は稀少なくせに\r\n効果が大きいとは言い難いからな"
      },
      "MsgSerial" : 93112,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 4,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "However, despite the cooperation of supporters, \r\nso far, there has been no other method found.",
        "Jp" : "しかし、賛同者たちの協力にもかかわらず\r\nこれまで、まったくと言っていいほど\r\n他の方法は見つかっていない"
