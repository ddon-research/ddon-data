      "GmdIndex" : 6,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "[Maritia the Kidnapper] nests in\r\nthe Peddler's Peril.",
        "Jp" : "\"子攫いのメリーティア\"は\r\n《行商人の難所》に\r\n巣食っているわ"
      },
      "MsgSerial" : 527315,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 7,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "Even among Nightmares, 'tis a vicious specimen\r\nthat knows the taste of human flesh.\r\nDo take care.",
        "Jp" : "ナイトメアの中でも\r\n人の味を知った凶悪な個体よ\r\nくれぐれも気を付けてね"
      },
      "MsgSerial" : 482111,
      "MsgType" : 0,
      "SetMotion" : 0,
