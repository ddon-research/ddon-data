    "GroupSerial" : 17660,
    "GroupType" : 0,
    "GroupTypeName" : "MSG_GROUP_TYPE_NONE",
    "MsgData" : [ {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 8,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "[Maritia the Kidnapper] — you've defeated her!\r\nKnowing you, I ne'er doubted you'd prevail\r\nagainst that monster too!",
        "Jp" : "\"子攫いのメリーティア\"を\r\n討伐してきてくれたのね！\r\n貴方のことだから、きっとあの魔物相手にも\r\n上手くやってくれると信じていたわ！"
      },
      "MsgSerial" : 558706,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 9,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "With this, Maritia'll likely up and change \r\nlairs anew— \r\nOr lie low till her wounds knit.",
        "Jp" : "これでメリーティアも\r\nまた住み処を変えるか\r\n傷が癒えるまで大人しくしているでしょう"
      },
      "MsgSerial" : 482154,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 10,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "The village parents will\r\nsurely breathe easier now.\r\nTake this as our thanks — from\r\nme, and from them all.\r\nDo accept it.",
        "Jp" : "きっと村の親たちも安心すると思うわ\r\nこれは、私と親たちの気持ちだと思って\r\n受け取ってちょうだい"
      },
      "MsgSerial" : 482163,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    } ],
