      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "At last, we've arrived at this point...\r\nI've tried to consider what's\r\nneeded for the Arisen to fight\r\nagainst the Black Dragon in my own way.",
        "Jp" : "いよいよ、といったところだな――\r\nオレも、オレなりに黒竜と戦うにあたって\r\n覚者に何が必要なのか考えてみた"
      },
      "MsgSerial" : 809015,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 1,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "As a smith, I want to ensure you,\r\nthe commander of the Arisen,\r\nis informed of this as well.",
        "Jp" : "武具を鍛える者として\r\n覚者隊の統率たるお前にも\r\nぜひ伝えておきたい"
      },
      "MsgSerial" : 818005,
