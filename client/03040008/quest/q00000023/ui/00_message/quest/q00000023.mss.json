      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 43,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "That much is trivial for me to accomplish.",
        "Jp" : "それくらいのことはなんの造作も無くできる"
