      "DispType" : 0,
      "GmdIndex" : 45,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "So, the seal is on the brink of collapse,\r\nand his full awakening impending—crisis is imminent.",
        "Jp" : "つまり封印の崩壊と奴の完全なる覚醒――\r\n危機は目前に迫っているんだ"
      },
      "MsgSerial" : 165958,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
