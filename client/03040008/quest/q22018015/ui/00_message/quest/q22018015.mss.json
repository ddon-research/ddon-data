      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "",
        "Jp" : "あんなのでも、あたしらにとっては\r\n可愛い妹だからね\r\n覚者さん、助けてくれて本当に感謝するよ\r\n帰ったらキツーく言っておくからね！"
      },
      "MsgSerial" : 630208,
      "MsgType" : 0,
