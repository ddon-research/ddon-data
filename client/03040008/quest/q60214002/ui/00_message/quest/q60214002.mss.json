      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 9,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "That monster took flight thereafter... 'tis said\r\nit alighted near [<STG 815>].",
        "Jp" : "あの魔物はそのあと飛び立って\r\n《<STG 815>》の辺りに\r\n舞い降りたみたい"
      },
      "MsgSerial" : 544664,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
