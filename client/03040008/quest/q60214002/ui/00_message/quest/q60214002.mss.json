      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 8,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "I saw a monster — white, and large...\r\nOnly stole a glimpse from the shade\r\nof the trees, mind...\r\n'Twas beautiful... near divine, even.\r\nBut 'twas terribly frightening —",
        "Jp" : "わたし、白くて大きな魔物を見たの\r\n木陰から少し覗き見たくらいなんだけど\r\nちょっと神々しいくらいにきれいだったわ\r\nでも、すごく怖かった――"
      },
      "MsgSerial" : 544663,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
