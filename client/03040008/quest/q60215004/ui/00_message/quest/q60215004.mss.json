    "NameDispOff" : false,
    "NpcId" : 2509,
    "NpcName" : {
      "En" : "Orla",
      "Jp" : "オリア"
    }
  }, {
    "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgGroup",
    "GroupNameSerial" : 0,
    "GroupSerial" : 19344,
    "GroupType" : 0,
    "GroupTypeName" : "MSG_GROUP_TYPE_NONE",
    "MsgData" : [ {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 7,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "What?! — You took down that new Tarasque?!",
        "Jp" : "な、なんだって！？\r\nあの新手のタラスクを\r\n討伐してきたっていうのかい！"
      },
      "MsgSerial" : 516415,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 8,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "True enough — the rumbling stopped\r\nsudden-like, a bit afore.\r\nWhile we was runnin' round in circles...\r\nYou stepped up and saved the village with\r\nyour own two hands, eh?",
        "Jp" : "確かに、少し前に急に地鳴りが止んだよ\r\n――あたしらが右往左往している間に\r\nあんたはその腕でいち早く村を救ったんだね"
      },
      "MsgSerial" : 552866,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 9,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "The warrior village, Dana — standing here\r\nbecause of martial might.\r\nNe'er dreamed an outsider from foreign shores'd\r\nbe the one teachin' me that, eh!",
        "Jp" : "戦士の村・ダナは、その武勇によって\r\nここに在ったっていうのに\r\nまさか他所の国から来たあんたに\r\nそのことを教えられるとは！"
      },
      "MsgSerial" : 552867,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 10,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "Whate'er foe comes — the grit to grab a\r\nblade and face it down...\r\nCan't match that, eh?\r\nSaved Dana, you did. Truly... thank you.",
        "Jp" : "どんな強大な敵であっても、武器をとって\r\n立ち向かう勇敢さ――\r\nあんたには頭が上がらないよ\r\nダナを救ってくれて、本当にありがとう"
      },
      "MsgSerial" : 552868,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    } ],
