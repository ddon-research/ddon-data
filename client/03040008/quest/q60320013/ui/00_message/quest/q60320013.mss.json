      "DispType" : 0,
      "GmdIndex" : 3,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "",
        "Jp" : "面目ないが、俺の代わりにそのアイテムを\r\n取り返して、グレゴリーに見せてきてくれないか\r\nそこまでが俺に任された任務だったんだ\r\n――頼んだぞ"
      },
      "MsgSerial" : 771413,
      "MsgType" : 0,
