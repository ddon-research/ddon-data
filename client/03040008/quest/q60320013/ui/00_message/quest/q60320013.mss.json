      "DispType" : 0,
      "GmdIndex" : 2,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "",
        "Jp" : "後ろから――野盗に襲われてアイテムを\r\n奪われてしまったんだ――"
