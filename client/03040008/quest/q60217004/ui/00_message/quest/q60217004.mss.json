    "GroupTypeName" : "MSG_GROUP_TYPE_NONE",
    "MsgData" : [ {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 6,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "Arisen of the White Dragon...\r\nThe other day, that traveler you helped\r\ncame to Glyndwr again.\r\nUm, a traveler named Ide...",
        "Jp" : "白き竜の覚者さま――\r\nこの前、覚者さまに助けてもらった旅の人が\r\nまたグリンデュアに来てくれたの\r\nえっと、イデさんっていう旅の人――"
      },
      "MsgSerial" : 516428,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 7,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "Ide said that when facing Corruption Demons,\r\nproper preparation is necessary.",
        "Jp" : "それでね、イデさんが言ってたの\r\n侵食魔と戦う時には、それなりの準備が必要だって"
      },
      "MsgSerial" : 552824,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 8,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "Say, Master Arisen... you're off to fight the\r\nCorruption Demons, aren't you?\r\nYour belongings, your equipment, your\r\ncompanions... I pray you review them all\r\nthoroughly ere you depart.",
        "Jp" : "ねぇ、覚者さまも\r\nこれから侵食の悪魔と戦いにいくんでしょう？\r\n持ち物とか、装備とか、一緒に行く人とか\r\n全部しっかり見直して向かってね"
      },
      "MsgSerial" : 552825,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 9,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "The Corruption Demon... 'tis terribly\r\nfrightening, I hear.\r\nThey say 'tis different from ordinary monsters.\r\nEven Ide said so...!\r\nPray, review your equipment and belongings\r\nproperly. Promise me.",
        "Jp" : "侵食の悪魔はとっても怖いって\r\n普通の魔物とは違うんだって\r\nイデさんも言ってたから！\r\nちゃんと装備や持ち物を見直してね、約束よ"
      },
      "MsgSerial" : 552826,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    } ],
