      "DispType" : 0,
      "GmdIndex" : 13,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "This tale ends here.\r\nShall we return?\r\n...Dear me. Regret still lingers\r\nwithin me, it seems.",
        "Jp" : "今回の話はここまでだ\r\n帰るとしようか\r\nいけないね、私の中にまだ後悔があるみたいだ"
      },
      "MsgSerial" : 790276,
      "MsgType" : 0,
