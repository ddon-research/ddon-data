      "GmdIndex" : 1,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "Once the [Core Tree] is restored, \r\nthe land of Phindym will heal— \r\nYou are tasked with rooting out\r\nthe monsters near the affected area \r\nas preparation for the cure.",
        "Jp" : "\"芯なる樹\"が元に戻ればフィンダムの大地は\r\n回復する――\r\nそして、君たちは、治療の準備として\r\n患部周辺の魔物の掃討を任されているわけだ"
      },
      "MsgSerial" : 437443,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
