      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 2,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "That's a pressure I could never withstand. \r\nYou truly are something else.",
        "Jp" : "僕なんかには耐えられない重圧だな\r\nさすがだよ"
      },
      "MsgSerial" : 437444,
      "MsgType" : 0,
      "SetMotion" : 0,
