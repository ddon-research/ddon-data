      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "You refer to the tainted monsters\r\nas \"Corruption Monsters,\" it seems.",
        "Jp" : "あなたたちは毒に侵された魔物を\"侵食魔\"と\r\n呼んでいるそうだな"
      },
      "MsgSerial" : 383179,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 4,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "―― It is indeed a name full of insight.",
        "Jp" : "――実に示唆に富んだ名だ"
      },
      "MsgSerial" : 383182,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
