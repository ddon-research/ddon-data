      },
      "MsgSerial" : 383185,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 8,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "If the core vein can be healed, \r\nWillmia should regain consciousness\r\nas her madness may subside.",
        "Jp" : "芯脈が治癒できれば\r\nウィルミアも本来の意識を取り戻すだろう"
      },
      "MsgSerial" : 383186,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 9,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "However, for Willmia at present, \r\nwe too are external foes that \r\nhave invaded the tree.",
        "Jp" : "ただ、いまのウィルミアにとっては\r\n我々も樹内に侵入した外敵――"
