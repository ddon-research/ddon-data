      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 7,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "... Hoh, I see. Orc survivors and a\r\nTroll, were there?",
        "Jp" : "――ほう、そうか\r\nオークの生き残りとトロールがいたのか"
      },
