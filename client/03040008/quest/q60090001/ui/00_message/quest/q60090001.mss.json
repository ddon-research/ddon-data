      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 2,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "Apparently, a man-eating ogre showed up\r\nand ate the priest during their prayers.\r\nAfter that, they sealed the entrance to keep\r\nthe ogre from getting out.",
        "Jp" : "でもある時人喰い鬼が現れて、\r\nお祈り中の司祭様を食っちまったらしくてね\r\n当時の人達、鬼が出ないように入り口を\r\n閉じちまったそうなんだ"
      },
      "MsgSerial" : 286385,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
