      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 3,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "We're all struggling with resource shortages now,\r\nbut I was thinking... the graves of the wealthy\r\nmight have some good gear or tools buried within\r\nthem, right?",
        "Jp" : "資源不足で今わたしらはひーひー言ってるけどさ\r\n裕福な人の墓なら\r\nいい装備や道具が眠ってるかもしれないだろ？"
      },
      "MsgSerial" : 286386,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
