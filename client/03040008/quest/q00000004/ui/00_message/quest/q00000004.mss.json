      "GmdIndex" : 9,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "The bridge was washed away in the previous flood,\r\nand there is no prospect of restoration at all.\r\nWhere do you intend to go?",
        "Jp" : "前の大水で橋が流されてな\r\n復旧の目処はまったく立っていない\r\n――どこへ行くつもりなんだ？"
      },
      "MsgSerial" : 253071,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
