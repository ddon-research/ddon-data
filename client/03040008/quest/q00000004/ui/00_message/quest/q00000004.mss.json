    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 10,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "I see... Pawn Cathedral.\r\nThen I suggest you turn around and go back.",
        "Jp" : "なるほど、《ポーン郷》か\r\nならば一度、引き返すことをすすめるよ"
