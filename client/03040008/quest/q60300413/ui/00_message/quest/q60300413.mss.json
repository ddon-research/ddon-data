      "DispType" : 0,
      "GmdIndex" : 16,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "Recently, my boys found one\r\nburied in da dirt at\r\nVolden Mine, see?",
        "Jp" : "最近――手下どもが\r\nボルド鉱山の、土の中に\r\n埋まってたのを見つけた"
      },
      "MsgSerial" : 650618,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
