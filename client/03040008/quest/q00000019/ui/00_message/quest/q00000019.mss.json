    "GroupSerial" : 8203,
    "GroupType" : 0,
    "GroupTypeName" : "MSG_GROUP_TYPE_NONE",
    "MsgData" : [ {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 6,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "I apologize, but I have a request. \r\nIt's something only you, within these\r\ncurrent circumstances, can handle. \r\nRest can come afterwards.",
        "Jp" : "悪いが頼みがある\r\n事情を知るおまえにしか頼めないことだ\r\n休息はそのあとにしてくれ"
