      "GmdIndex" : 20,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "Up until now, this would be met with a laugh, \r\nbut there's the precedent of Iris to consider――",
        "Jp" : "と、これまでなら一笑に付すところだが\r\nイリスという前例があるからな――"
      },
      "MsgSerial" : 164795,
