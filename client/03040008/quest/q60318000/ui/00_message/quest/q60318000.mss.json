      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 3,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "We've no one left to dispatch\r\non the investigation.\r\nForgive me for entrusting you with this, but\r\ngather what tidings you can on the missing\r\nsoldiers—and if 'tis possible, rescue them.",
        "Jp" : "これ以上、調査に向かわせられる者もいない\r\n一から任せてすまないが\r\n行方不明になった戦士たちの情報を集め\r\n――叶うことならば、救出してもらえないか"
      },
      "MsgSerial" : 606644,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    } ],
    "NameDispOff" : false,
