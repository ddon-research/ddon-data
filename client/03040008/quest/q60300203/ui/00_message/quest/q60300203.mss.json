    "GroupTypeName" : "MSG_GROUP_TYPE_NONE",
    "MsgData" : [ {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 0,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "I apologize for the other day.\r\nI fear I showed you an unsightly side of myself—",
        "Jp" : "先日はすまなかったね\r\nカッコ悪いところを見せてしまった――"
      },
      "MsgSerial" : 790283,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 1,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "This time— well, then.\r\nThe place where you found the\r\nRing of the First King.\r\nI would go there and speak.",
        "Jp" : "今回は――そうだな\r\n君たちがサマラ初代王の指輪を見つけた場所\r\nそこへ行って話したい"
      },
      "MsgSerial" : 790284,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 2,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "The ring's location, which we\r\ntoo could not find...\r\n'Crumbling Entrance Path', was it?\r\n'Tis a rare chance — I'm curious what\r\nmanner of place it is.\r\nI'll follow you, so pray, lead the way.",
        "Jp" : "我々も見付けられなかった指輪の場所\r\n《崩れた進入路》、だったかな\r\nせっかくだ、どんなところなのか興味がある\r\n君の後を追うから、先導してくれるかい"
      },
      "MsgSerial" : 797328,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    } ],
    "NameDispOff" : false,
    "NpcId" : 4513,
    "NpcName" : {
      "En" : "Kirsty",
      "Jp" : "キルスティ"
    }
  }, {
    "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgGroup",
    "GroupNameSerial" : 0,
    "GroupSerial" : 30969,
