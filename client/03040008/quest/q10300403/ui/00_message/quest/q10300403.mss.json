      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "Hey, listen! Ser Sunika just\r\nslid into the mess hall and\r\nasked me something crazy!",
        "Jp" : "あ、ねぇねぇ！\r\nさっきスニーカーさんがスッと大食堂にやって来てさ\r\nすごいこと頼まれちゃった！"
      },
      "MsgSerial" : 640952,
      "MsgType" : 0,
