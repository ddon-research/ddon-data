      "DispType" : 0,
      "GmdIndex" : 1,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "The story of the \"Phantom Ingredient\"―\r\nYou want to hear it, don't you?",
        "Jp" : "\"幻の食材\"の話――聞きたいよね？"
