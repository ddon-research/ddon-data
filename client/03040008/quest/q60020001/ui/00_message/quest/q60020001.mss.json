      "DispType" : 0,
      "GmdIndex" : 21,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "I've every confidence you'll resolve the Breya\r\nCoast's troubles as well, Master Arisen!",
        "Jp" : "覚者さまならきっと《ブリア海岸》の問題も\r\n解決してくださると思ってます！"
      },
      "MsgSerial" : 286666,
