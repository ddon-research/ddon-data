  "NativeMsgGroupArray" : [ {
    "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgGroup",
    "GroupNameSerial" : 0,
    "GroupSerial" : 14484,
    "GroupType" : 0,
    "GroupTypeName" : "MSG_GROUP_TYPE_NONE",
    "MsgData" : [ {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 0,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "Ah, that's right! There's something I'd ask of\r\nyou, Master Arisen, now that you're\r\nembarking on a World Quest.",
        "Jp" : "――そうでした！\r\nワールドクエストに挑むことになった覚者さまに\r\nお願いしたいことがあるんです"
      },
      "MsgSerial" : 286574,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 1,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "E'er since the White Dragon fell to slumber,\r\nLestania's been beset by all manner\r\nof queer happenings—",
        "Jp" : "白竜さまがお眠りになってからというもの\r\nレスタニア各地ではさまざまな異変に\r\n苛まれているんです――"
      },
      "MsgSerial" : 286575,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 2,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "Just recently, the temple received word from\r\nO'Neill, Area Master of the western Breya Coast —\r\nhe's asking to be put in touch with a dependable\r\nArisen, should one be found.",
        "Jp" : "つい最近、西の《ブリア海岸》エリアマスター\r\nオニールさんから、頼りになる覚者さまがいたら\r\n紹介してほしいって神殿に連絡があったんですよ"
      },
      "MsgSerial" : 286576,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 3,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "Master Arisen, what say you? Pray, would you head\r\nto [Rotes Village] on the Breya Coast, to hear the\r\nbusiness of Ser O'Neill?",
        "Jp" : "覚者さま、どうでしょう？\r\nブリア海岸の《ローテス村》に向かい、オニールさん\r\nの用件を聞いてあげてもらえないでしょうか"
      },
      "MsgSerial" : 286577,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    } ],
    "NameDispOff" : false,
    "NpcId" : 1013,
    "NpcName" : {
      "En" : "Seneka",
      "Jp" : "セネカ"
    }
  }, {
    "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgGroup",
    "GroupNameSerial" : 0,
    "GroupSerial" : 14487,
    "GroupType" : 0,
    "GroupTypeName" : "MSG_GROUP_TYPE_NONE",
    "MsgData" : [ {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 4,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "Ah, so you're the rumored Arisen the temple sent\r\no'er. Much obliged for showing up!",
        "Jp" : "ああ、あんたが神殿が紹介してくれた\r\n噂の覚者さんだな\r\n来てくれてありがとう！"
      },
      "MsgSerial" : 286594,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 5,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "In truth, Rotes has been marked by a troublesome\r\nlot of late — they style themselves the Breya\r\nTreasure Bandits, a pirate's rabble\r\nifsoe'er there was one.",
        "Jp" : "実は、今ローテスは厄介な連中に\r\n目をつけられていてね\r\n《ブリア宝奪団》って名乗る海賊まがいさ"
      },
      "MsgSerial" : 286595,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 6,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "They're after \"The Treasure of Breya\" or so they\r\nsay. Threatenin' me to talk, tormentin' the\r\nvillagers — but I haven't a clue\r\nwhat they're on about—",
        "Jp" : "連中は\"ブリアの財宝\"ってのを探してるようなんだ\r\nオレに知ってることを話せと脅してきたり\r\n村人に絡んだりするけど、何のことかさっぱりで――"
      },
      "MsgSerial" : 286596,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 7,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "I'm beggin' you, Ser Arisen — won't you lend a\r\nhand? Track down the lot callin' themselves the\r\nBreya Treasure Bandits, and teach 'em not to\r\ncome near our village.",
        "Jp" : "お願いだ覚者さん、力を貸してくれないか？\r\n《ブリア宝奪団》と名乗る連中を\r\n見つけ出して、村に近づかないよう\r\n懲らしめてほしいんだ"
      },
      "MsgSerial" : 286597,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 8,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "Their hideout might be the Hidden Beach. Ruffians\r\nfrequent the place — 'twon't be long afore the\r\nvillage comes under attack.",
        "Jp" : "あいつらのアジトは《隠れ浜》かもしれない\r\nならず者がよく出入りしているんだ\r\nそのうち村が襲われても不思議じゃない"
      },
      "MsgSerial" : 286598,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 9,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "If they're not showin', try takin' on some Board\r\nQuests or World Quests in this area\r\nwhilst you wait and see.",
        "Jp" : "姿がないようなら、このエリアで\r\nボードクエストやワールドクエストを\r\nしながら様子を見てみてよ"
      },
      "MsgSerial" : 286599,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    } ],
    "NameDispOff" : false,
    "NpcId" : 1205,
    "NpcName" : {
      "En" : "O'Neill",
      "Jp" : "オニール"
    }
  }, {
    "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgGroup",
    "GroupNameSerial" : 0,
    "GroupSerial" : 14488,
    "GroupType" : 0,
    "GroupTypeName" : "MSG_GROUP_TYPE_NONE",
    "MsgData" : [ {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 10,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "Oh, so you drove off the ruffians at the Hidden\r\nBeach. Thank you, how'd it go?",
        "Jp" : "おっ、《隠れ浜》のならず者を追い払って\r\nくれたんだな\r\nありがとう、どうだった？"
      },
      "MsgSerial" : 286636,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 11,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "――Hmm, I see... From the sound of it, the\r\nsituation's different. Mayhap they're\r\nnaught but common bandits.",
        "Jp" : "――うーん、そうかぁ\r\nすこし聞いてる感じだと様子がちがうなぁ\r\nそれはただの野盗かもしれないな"
      },
      "MsgSerial" : 286637,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 12,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "If that's the case, that place a little ways down\r\nthe coast — the Seaside Cellar —\r\nlooks mighty suspicious.",
        "Jp" : "だとすれば、海岸少しいったところにある\r\nあの場所、《海辺の地下室》あたりが怪しいな"
      },
      "MsgSerial" : 286638,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 13,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "We sealed the place off — monsters 'n pirates\r\ngather there, makes it hazardous.",
        "Jp" : "あそこは魔物や海賊がたむろしやすくて\r\n危険だから封鎖したんだけどさ"
      },
      "MsgSerial" : 286639,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 14,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "Give it another go — keep watch whilst you're\r\nrunnin' Board Quests and World Quests.",
        "Jp" : "またボードクエストや、ワールドクエストを\r\nしながら様子を見てみてくれよ"
      },
      "MsgSerial" : 287694,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    } ],
    "NameDispOff" : false,
    "NpcId" : 1205,
    "NpcName" : {
      "En" : "O'Neill",
      "Jp" : "オニール"
    }
  }, {
    "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgGroup",
    "GroupNameSerial" : 0,
    "GroupSerial" : 14489,
    "GroupType" : 0,
    "GroupTypeName" : "MSG_GROUP_TYPE_NONE",
    "MsgData" : [ {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 15,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "Oh, so you did it! You wiped out the Breya\r\nTreasure Bandits — truly grateful, I am.",
        "Jp" : "おお、そうかい！\r\n《ブリア宝奪団》を退治してくれたのか\r\n本当に感謝だよ"
      },
      "MsgSerial" : 286648,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 16,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "If they're back at the hideout, turn the tables —\r\ntake their treasure for your own. The loot'd\r\nsurely sooner serve you.",
        "Jp" : "もしまた連中がアジトにいたら\r\n逆にやつらの宝を奪っちゃってよ\r\nあんたの役に立つ方がきっと宝も本望さ"
      },
      "MsgSerial" : 286649,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 17,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "But \"treasure sleeping in Breya,\" is it? If\r\nthat's true, 'tis certainly intriguin'... Come to\r\nthink on it, there was another village in Breya —\r\nan abandoned one on the south shore called Ruflow.",
        "Jp" : "でも、\"ブリアに眠る財宝\"か――\r\nそれが本当なら確かに気になるね\r\nそういえばブリアにはもう一つ村があったんだ\r\n南の浜辺の《ルフロー》っていう廃村がね"
      },
      "MsgSerial" : 286650,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 18,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "Mayhap that village holds the true connection to\r\nthe treasure in question.",
        "Jp" : "もしかしたら、例の財宝と関係あるのは\r\nそっちの村だったのかもしれないな"
      },
      "MsgSerial" : 286651,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 19,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "Only the tale remains — some fell calamity\r\nstruck, and Ruflow perished in a single night.\r\nBut in the end, the cause of its ruin stays a\r\nmystery. Mayhap the treasure had\r\nsomethin' to do with it—",
        "Jp" : "恐ろしいことがあって一夜で滅んだって\r\n話だけが残ってるんだけど、結局ルフローが\r\n滅んだ原因は謎のままなんだよ\r\n財宝と何か関係あったのかな――"
      },
      "MsgSerial" : 286652,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 20,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "Right! You might be the one to uncover the verity\r\nof Ruflow's downfall — and the treasure to boot.\r\nWhilst you're settlin' Breya's troubles, I'd ask\r\nyou to look into that business as well.",
        "Jp" : "そうだ！　あんたなら、ルフローが滅んだ\r\n真相や財宝も見つけられるんじゃないかな？\r\nブリアの問題を解決しながら、ぜひ\r\nそのあたりのことについても調べてくれよ"
      },
      "MsgSerial" : 286653,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    } ],
    "NameDispOff" : false,
    "NpcId" : 1205,
    "NpcName" : {
      "En" : "O'Neill",
      "Jp" : "オニール"
    }
  }, {
    "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgGroup",
    "GroupNameSerial" : 0,
    "GroupSerial" : 14490,
    "GroupType" : 0,
    "GroupTypeName" : "MSG_GROUP_TYPE_NONE",
    "MsgData" : [ {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
