      "GmdIndex" : 16,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "",
        "Jp" : "覚者さん、良かったらうちのオーナーに\r\n協力してやってよ\r\n見た目はアレだけど、悪い人じゃないみたいだからさ"
      },
      "MsgSerial" : 677754,
