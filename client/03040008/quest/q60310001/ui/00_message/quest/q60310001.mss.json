      "DispType" : 0,
      "GmdIndex" : 11,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "",
        "Jp" : "ね、覚者さんもよかったらうちのオーナー\r\n手伝ってあげてってよ！"
