      "GmdIndex" : 9,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "",
        "Jp" : "あたし、今バイトで呼び込みやってるの\r\nこの服、そこにいるオーナーの手作りなんだって！"
