      "DispType" : 0,
      "GmdIndex" : 8,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "",
        "Jp" : "ねぇ見てよこの服！\r\n斬新っていうか――イカしてるでしょ？\r\n結構気に入っちゃってるんだよね～"
      },
      "MsgSerial" : 677746,
      "MsgType" : 0,
