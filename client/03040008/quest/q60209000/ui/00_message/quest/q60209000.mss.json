      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 6,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "Preparing to march on us, taming fell beasts—\r\nFie, once the mind starts racing,\r\nthere's no cease to it.",
        "Jp" : "こっちに攻め込んでくる準備だとか\r\n魔獣を飼い慣らしてるとか――\r\nやだやだ、考え始めるとキリがないね"
      },
      "MsgSerial" : 482265,
