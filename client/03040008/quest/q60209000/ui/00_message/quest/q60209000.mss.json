      "GmdIndex" : 5,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "Hope the orcs aren't up to aught strange\r\nin Gardnox Fortress...",
        "Jp" : "ガルドノック砦の中で\r\nオークたちが変なことしてないといいんだけど――"
      },
      "MsgSerial" : 446222,
      "MsgType" : 0,
      "SetMotion" : 0,
