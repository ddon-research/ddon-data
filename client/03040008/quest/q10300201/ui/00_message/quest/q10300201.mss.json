      "GmdIndex" : 10,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "I could be busy avoiding monsters, \r\nso can you remember that? \r\nOn the way to Piremoth, there's <COL ff2600>[clay soil].</COL>",
