    "GroupType" : 0,
    "GroupTypeName" : "MSG_GROUP_TYPE_NONE",
    "MsgData" : [ {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 7,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "My name is <NPC 1047>.\r\nTo serve the White Dragon wholeheartedly,\r\nI've honed this craft not just for myself,\r\nbut to draw out the strength of fellow Arisen.",
        "Jp" : "オレの名は<NPC 1047>という\r\nただひたすらに白竜に貢献するため\r\n自分個人だけでなく、周りの覚者たちの力を\r\n引き出すよう、この腕を磨いてきた"
      },
      "MsgSerial" : 652323,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 8,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "<NPC 4> asked me to fight on the front lines\r\nof Gritten, but I... I saw the limits of\r\nwhat one person alone can accomplish.",
        "Jp" : "<NPC 4>からはグリッテンの前線で\r\n戦ってほしいと言われていたが\r\nオレは――自分一人で成し遂げられることの\r\n限界を見たんだ"
      },
      "MsgSerial" : 652324,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 9,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "Rather than testing how many orcs I can\r\ndefeat alone, it would be better to\r\nenhance the equipment of the Arisen and\r\nstrengthen the Arisen Corps as a whole.",
        "Jp" : "オレ一人が何体のオークを倒せるか――\r\nそこに挑むより、覚者たちの装備品に\r\nより磨きをかけることで、覚者隊全体の\r\n武力を上げた方がよいのではないか、と――"
      },
      "MsgSerial" : 652325,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 10,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "Through years of journeying, pursuing\r\neach land's traditions and crafts—\r\nat journey's end, I learned the secret\r\nof enhancing equipments' strength.",
        "Jp" : "そして旅に出て、長年に渡り\r\nあらゆる地域の伝承や技術を追求する日々――\r\nその果てに、武具の持つ力を\r\n合成する秘術を体得したのだ"
      },
      "MsgSerial" : 652801,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 11,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "This secret art... no, let's call it a technique—\r\nWith equipment enhanced by this technique,\r\nyou too can perform even greater deeds.",
        "Jp" : "この秘術――いや、素直に技術といおう――\r\n磨き抜いた技術で強化した武具で\r\nお前も一層の働きをみせてくれ"
      },
      "MsgSerial" : 652802,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    } ],
    "NameDispOff" : false,
    "NpcId" : 1047,
    "NpcName" : {
      "En" : "Craig",
      "Jp" : "クレイグ"
    }
