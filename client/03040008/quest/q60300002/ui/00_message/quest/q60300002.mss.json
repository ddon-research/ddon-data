    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 1,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "As thanks...\r\nI'll tell you about my newly established workshop.\r\nIt will surely benefit you.\r\nListen carefully.",
        "Jp" : "礼として――\r\nここに新設した我が工房について教えてやる\r\n必ずお前のためになるだろう\r\n心して聞いてくれ"
      },
      "MsgSerial" : 652318,
      "MsgType" : 0,
