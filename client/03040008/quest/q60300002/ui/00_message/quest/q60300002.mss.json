    "GroupTypeName" : "MSG_GROUP_TYPE_NONE",
    "MsgData" : [ {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 2,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "To me, an Arisen is someone who can value\r\nboth life and objects. You're not a true\r\nArisen if you can't feel attachment to the\r\nequipment that protects your life.",
        "Jp" : "オレにとって――覚者というのは\r\n命も物も大事にできて一人前だと思っている\r\n自分の命を守る武具に愛着を\r\n持てないヤツは覚者として失格だ"
      },
      "MsgSerial" : 630644,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 3,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "If you think so too,\r\nlisten closely to what I have to say.",
        "Jp" : "もしお前もそう思うなら\r\nオレの話をしっかり聞くことだ"
      },
      "MsgSerial" : 652319,
