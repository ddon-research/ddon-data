      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 16,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "It is said you can enter a \"restricted area\"\r\naccessible only for a limited time. There,\r\nyou may obtain powerful draconic energy.",
        "Jp" : "限られた期間しか入ることができない\r\n《入場制限スポット》に入れて\r\nしかも、その中では強力な竜力を\r\n得ることができるっていう話です"
      },
      "MsgSerial" : 630932,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
