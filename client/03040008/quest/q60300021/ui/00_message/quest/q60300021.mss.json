      "GmdIndex" : 15,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "The statues of the heroic spirits? \r\nIf you touch the one at the far end of \r\nthe \"Realm of Heroic Spirits\"—",
        "Jp" : "英霊の石像ですか？\r\n《英霊の間》の一番奥に置かれている\r\n石像に触ると――"
      },
      "MsgSerial" : 630931,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
