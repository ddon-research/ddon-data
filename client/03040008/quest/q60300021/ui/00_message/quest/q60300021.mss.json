    "NpcName" : {
      "En" : "Ira",
      "Jp" : "アイラ"
    }
  }, {
    "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgGroup",
    "GroupNameSerial" : 0,
    "GroupSerial" : 26052,
    "GroupType" : 0,
    "GroupTypeName" : "MSG_GROUP_TYPE_NONE",
    "MsgData" : [ {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 12,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "The trials of the stone tablet were prepared\r\nby our ancestors to protect this place.",
        "Jp" : "石版の試練は、ここを守るために\r\n先人たちが用意した試練なんだそうです"
      },
      "MsgSerial" : 630928,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 13,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "By touching the stone slab among the \r\nheroic spirits, \"trial enemies\" appear, \r\nand one must overcome them.",
        "Jp" : "英霊の間にある石版に触れることで\r\n\"試練の敵\"があらわれて――\r\nそれに打ち勝たないといけないんだとか"
      },
      "MsgSerial" : 630929,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 14,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "Heh, it sounds like a child's tale of adventure...\r\nbut many believe it. \r\nI admit, I too am somewhat... hopeful.",
        "Jp" : "ふふ、子供が好きそうな冒険話ですよね\r\n――でも、信じている人も多いんですよ\r\n私もちょっと――期待はしているくらいです"
      },
      "MsgSerial" : 630930,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    } ],
    "NameDispOff" : false,
    "NpcId" : 610,
    "NpcName" : {
      "En" : "Ira",
      "Jp" : "アイラ"
    }
  }, {
    "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgGroup",
