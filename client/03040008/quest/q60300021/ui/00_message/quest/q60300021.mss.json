    "GroupTypeName" : "MSG_GROUP_TYPE_NONE",
    "MsgData" : [ {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 0,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "It is common knowledge that Lookout Castle was\r\noriginally built to intimidate the southern\r\nbarbarians.",
        "Jp" : "展望城は元々、南の地の蛮族に\r\n睨みをきかせるために建造されたと\r\nされておるのは皆が知るところ"
      },
      "MsgSerial" : 630919,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 1,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "However, if that were the sole purpose, there\r\nwere other suitable locations for a castle.\r\nWhy did the previous royal family choose \"this place\"\r\nto build it?",
        "Jp" : "しかし、それだけを目的とするのなら\r\n城を建造するに向いた土地は他にもあるのです\r\n――先の王族方がどうして\"この場所\"に\r\n建てるとお決めになったのか"
      },
      "MsgSerial" : 630920,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 2,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "It is because this place happens to be a\r\n\"special site where strong draconic power flows.\"",
        "Jp" : "それは、この場がちょうど\r\n\"強い竜力が流れる特別な場\"だからです"
      },
      "MsgSerial" : 630921,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 3,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "Whether they sought to protect that draconic\r\npower or harness it, I cannot say—",
        "Jp" : "その竜力を守ろうとしたのか\r\nあるいは利用しようとしたのかは\r\nわしにはわかりませぬが――"
      },
      "MsgSerial" : 630922,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 4,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "But surely you are aware, Ser Arisen, that\r\nmany legends surrounding it remain.",
        "Jp" : "しかし、それにまつわる\r\n伝承が数多く残っているのは\r\n覚者様もご存じでしょう"
      },
      "MsgSerial" : 713371,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 5,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "If you seek power, Ser Arisen—now would be\r\nthe time to head to the <STG 1143>.",
        "Jp" : "覚者様が力を求められるのであれば――\r\n《<STG 1143>》に向かわれた方が\r\nよい頃でしょうな"
      },
      "MsgSerial" : 713372,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    } ],
    "NameDispOff" : false,
