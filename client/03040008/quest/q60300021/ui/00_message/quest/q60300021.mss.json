      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 17,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "Quite an exciting tale, isn't it? Anyone\r\nraised in Acre Selund likely remembers\r\nthe thrill of this story from childhood.",
        "Jp" : "なんだかわくわくする話ですよね\r\nアッカーシェランで育った人ならみんな\r\n子どもの頃、この話にワクワクしていた記憶が\r\nあるんじゃないでしょうか"
      },
      "MsgSerial" : 630933,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    } ],
    "NameDispOff" : false,
    "NpcId" : 610,
