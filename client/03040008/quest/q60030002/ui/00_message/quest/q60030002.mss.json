  "NativeMsgGroupArray" : [ {
    "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgGroup",
    "GroupNameSerial" : 0,
    "GroupSerial" : 14426,
    "GroupType" : 0,
    "GroupTypeName" : "MSG_GROUP_TYPE_NONE",
    "MsgData" : [ {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 0,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "You'll take this on, then? Thank you! The Mysree\r\nLimestone Cave has long been home to\r\nfearsome beasts.",
        "Jp" : "引き受けてくれるのね、ありがとう！\r\n《ミスリウ鍾乳洞》には以前から強力な\r\n魔獣が棲んでいたの"
      },
      "MsgSerial" : 286175,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 1,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "Most famed among them are the mated Chimera the\r\nForest Goblins revere—Demonic Lion Singha\r\nand White Lion Albus.",
        "Jp" : "中でも有名なのがフォレストゴブリン達が崇める\r\nつがいのキメラ、\r\n《魔獅子シンガ》と《白獅子アルバス》よ"
      },
      "MsgSerial" : 286176,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 2,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "The [Mysree Limestone Cave] is that Singha's\r\nlair. Before, a hunter unit dealt it nigh-fatal\r\nwounds and cornered it—",
        "Jp" : "《ミスリウ鍾乳洞》は、そのシンガの住処なの\r\n前に、ハンター部隊がヤツに瀕死の重傷を\r\n負わせて追いつめたんだけど――"
      },
      "MsgSerial" : 286177,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 3,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "The beast was mere one step from the end when it\r\nfled deep into the heart of the limestone cavern.\r\nHaven't set eyes on it since, so I took it for\r\ndead. Sealed the entrance just in case, though.",
        "Jp" : "もう一歩というところでヤツは鍾乳洞の奥に\r\n逃げ戻ってしまった\r\n以来姿を見せないから死んだと思っていたわ\r\n念のため、入口は封鎖していたけど"
      },
      "MsgSerial" : 286178,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 4,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "Of course — I've told as much to the Knight's\r\nOrder group that went ahead to\r\ninvestigate as well.\r\nWon't you find them and bring them back somehow?",
        "Jp" : "――もちろん、先に調査に行った騎士団にも\r\nこのことは伝えたわ\r\nなんとか探して、連れ帰ってくれないかしら"
      },
      "MsgSerial" : 286179,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    } ],
    "NameDispOff" : false,
    "NpcId" : 1412,
    "NpcName" : {
      "En" : "Patricia",
      "Jp" : "パトリシア"
    }
  }, {
    "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgGroup",
    "GroupNameSerial" : 0,
    "GroupSerial" : 14427,
    "GroupType" : 0,
    "GroupTypeName" : "MSG_GROUP_TYPE_NONE",
    "MsgData" : [ {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 5,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "So — 'tis a pity about the Knight.\r\nTo think Singha was truly alive...",
        "Jp" : "そう――騎士のことは残念だわ\r\nまさかシンガが本当に生きていたなんて"
      },
      "MsgSerial" : 286180,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 6,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "But you drove it back—! Truly, I'm grateful.\r\nShould that demonic lion have\r\nsurfaced, Lynwood would surely—",
        "Jp" : "でも、あながたが撃退してくれた――！\r\n本当に感謝しているわ\r\nもしあの魔獅子が地上に現れたら\r\nきっとリンウッドは――"
      },
      "MsgSerial" : 286181,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 7,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "But we can't be fully at ease. A demon lion,\r\neven at death's door, rises again thanks to the\r\nserpent's fearsome vitality — so 'tis said.",
        "Jp" : "でも、完全に安心はできないわ\r\n魔獅子は死に瀕してもなお、恐るべき蛇の\r\n生命力で再び立ちあがるというの"
      },
      "MsgSerial" : 286182,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 8,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "The hunters prior should've slain it outright...\r\nyet they swore it revived unseen, ere it fled\r\ninto the limestone cavern.",
        "Jp" : "以前のハンターたちも、完全に仕留めたはず\r\nなのに知らぬ間に息を吹き返したと言っていた\r\n鍾乳洞に逃げ込まれる前にね"
      },
      "MsgSerial" : 286183,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 9,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "If it's revived anew... this time, put it down\r\nfor good. As it is, mayhap the White Lion Albus\r\nhas awakened in the forest depths as well—",
        "Jp" : "もしまたヤツが息を吹き返していたら\r\n今度こそ仕留めてちょうだい\r\nこの分だと、森の深部では《白獅子アルバス》も\r\n目を覚ましているかもしれないわね――"
      },
      "MsgSerial" : 286184,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    } ],
    "NameDispOff" : false,
    "NpcId" : 1412,
