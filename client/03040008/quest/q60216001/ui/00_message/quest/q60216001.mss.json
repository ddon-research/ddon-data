    }
  }, {
    "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgGroup",
    "GroupNameSerial" : 0,
    "GroupSerial" : 19269,
    "GroupType" : 0,
    "GroupTypeName" : "MSG_GROUP_TYPE_NONE",
    "MsgData" : [ {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 15,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "Gh—\r\nThank you.\r\nNow I can sleep soundly.",
        "Jp" : "うっ――\r\nありがとうございます\r\nこれで安心して眠れます――"
      },
      "MsgSerial" : 515550,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 16,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "Ser Arisen— To ask you to\r\nstrike down fellow humans.\r\nSuch a request... yet you\r\naccepted it without a word.\r\nI am truly grateful—",
        "Jp" : "覚者様――\r\n同じ人間を討ってきてくれだなんて\r\nこんなお願い、黙って聞き入れてくださって\r\n本当に感謝しています――"
      },
      "MsgSerial" : 544745,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 17,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "Naught but blunders, truly... how pathetic...\r\nI... I want to become stronger, too.\r\nUu... for the infected... for\r\ntheir sake as well...",
        "Jp" : "本当にヘマばかりして、情けない――\r\n僕ももっと強くなりたいです\r\nうぅ、侵食された人たちのためにも――"
      },
      "MsgSerial" : 544746,
      "MsgType" : 0,
