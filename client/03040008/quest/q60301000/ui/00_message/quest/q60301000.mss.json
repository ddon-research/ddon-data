      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "At last, the time has come.\r\nThis year, many sweets, I shall have—\r\nFufufu—fufufufu—",
        "Jp" : "ヨウヤク、コノキセツガキタワネ\r\nコトシコソハ――オカシヲ、タクサン――\r\nフフフフ――フフフフフ――"
      },
      "MsgSerial" : 679421,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
