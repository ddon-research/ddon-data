    "GroupTypeName" : "MSG_GROUP_TYPE_NONE",
    "MsgData" : [ {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 17,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "Ah, Ser, just a moment ago, I saw a \r\nbeautiful woman in strange attire muttering \r\nto herself as she walked towards the well— \r\nIt was quite the sight, I assure you— \r\nShe seemed rather lost in thought.",
        "Jp" : "ああ、覚者さん\r\nついさっき、不思議な恰好の美女が\r\nブツブツ独り言を言いながら\r\n井戸の方に歩いていったのを見たんだよ"
      },
      "MsgSerial" : 680386,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 18,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "Curious about what was happening, \r\nI followed her, but no matter how much I peered \r\ninto the well, there was no one inside— \r\nIt was as if she had vanished into thin air.",
        "Jp" : "何事かと思って後を追ったんだけど\r\nいくら覗いても井戸の中には\r\n誰もいないんだ"
      },
      "MsgSerial" : 680387,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 19,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "It was so dark that I gave up searching and \r\ncame out. I need something bright to \r\nshine a light on the situation; without \r\nit, searching is futile in this darkness.",
        "Jp" : "真っ暗だし、探すのをやめて出てきたよ\r\n何か明るく照らすものがないとダメだな"
      },
      "MsgSerial" : 692187,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    } ],
    "NameDispOff" : false,
    "NpcId" : 1304,
