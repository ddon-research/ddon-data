      "GmdIndex" : 0,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "Well, that time of the year has come 'round again—\r\nit's Halloween season, but, something's strange\r\nabout little Ms. Shelly this year.",
        "Jp" : "やあ、今年もハロウィンの季節がきたんだが――\r\n実はシェリーちゃんの様子が変なんだ"
      },
      "MsgSerial" : 679420,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 1,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "It doesn't seem like she's angry,\r\nbut when she speaks, it's awfully strange.\r\nI have no idea why she's behaving like that.\r\nPlease, could you take a look at her as well?",
        "Jp" : "怒ってるわけでも無さそうだし\r\n喋ると何だか妙に怖いしで\r\nああなっている理由がさっぱりわからない\r\n頼む、君も様子をみてくれないか"
      },
      "MsgSerial" : 692093,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    } ],
    "NameDispOff" : false,
    "NpcId" : 4714,
    "NpcName" : {
      "En" : "Angelo",
      "Jp" : "アンジェロ"
    }
  }, {
    "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgGroup",
