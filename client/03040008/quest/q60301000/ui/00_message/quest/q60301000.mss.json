    }
  }, {
    "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgGroup",
    "GroupNameSerial" : 0,
    "GroupSerial" : 27118,
    "GroupType" : 0,
    "GroupTypeName" : "MSG_GROUP_TYPE_NONE",
    "MsgData" : [ {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 14,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "Ah, so this is the Ghost Lantern! \r\nI intended to illuminate Ms. Shelly \r\nimmediately— but alas, it appears \r\nthat she has wandered off \r\nsomewhere. Where could she be now?",
        "Jp" : "おおお、それがゴーストランタンか！\r\n早速シェリーちゃんを照らして\r\n――と思ったのだが、当のシェリーちゃんが\r\nどこかへ行ってしまったのだ"
      },
      "MsgSerial" : 679429,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 15,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "I tried to pursue her, but despite \r\nbeing a bit wobbly, she's surprisingly \r\nfast— I ended up losing track of \r\nher, and now she's nowhere to be found— \r\nWhere could she possibly be?",
        "Jp" : "追いかけたのだが、フラフラしてる割に\r\n意外と足が速くて――\r\nみ、見失ってしまって――"
      },
      "MsgSerial" : 679430,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 16,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "I think she went\r\nin the direction of Tel Village.\r\n—Please, go find her!",
        "Jp" : "方向的にはテル村の方へ\r\n行ったんじゃないかと思うんだがね\r\n――頼む、彼女を探してきてくれ！"
      },
      "MsgSerial" : 692186,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
