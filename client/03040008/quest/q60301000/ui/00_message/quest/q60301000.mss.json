      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 4,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "Nevermind that.\r\nSweets, gimme!",
        "Jp" : "ソンナコトヨリ\r\nオカシ、チョウダイ"
