      "GmdIndex" : 12,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "As commander of Megado's defenses,\r\nand Area Master of the Megadosys Plateau,\r\nI offer you our heartfelt thanks and respect.",
        "Jp" : "このメガドを護る兵の長として\r\nそしてメガドシス高地のエリアマスターとして\r\n覚者様に感謝と最大限の敬意を表します"
      },
      "MsgSerial" : 754184,
      "MsgType" : 0,
      "SetMotion" : 0,
