    "GroupType" : 0,
    "GroupTypeName" : "MSG_GROUP_TYPE_NONE",
    "MsgData" : [ {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 8,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "Leo disappeared while still in possession\r\nof the Vessel of Life――",
        "Jp" : "レオが命の器を持ったまま\r\n姿を消してしまった――"
      },
      "MsgSerial" : 21037,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 9,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "I was surprised, but in truth―― \r\nI think Leo and I are thinking the same thing.",
        "Jp" : "驚いたけど、実は――\r\nレオと僕は同じことを考えていると思う"
      },
      "MsgSerial" : 254741,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 10,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "I can confidently say that aside from the Lord\r\nWhite Dragon, there is no other place to offer up\r\nthe lives within the Vessel except the Third Ark.",
        "Jp" : "断言してもいいけど、白竜様の他に\r\n器の命を捧げる場所は\r\n第三のアーク以外にはない"
      },
      "MsgSerial" : 163600,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 11,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "I ask you, \r\ngo and support Leo with your strength. \r\nActivate the Ark and open the Gate!",
        "Jp" : "お願いだ\r\n君も行って、レオの力になってあげてほしい\r\nアークを起動して\"ゲート\"を開くんだ！"
      },
      "MsgSerial" : 163601,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 12,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "What? The Commander of the Knights,\r\nGerd is going too?",
        "Jp" : "え？　ゲルト騎士団長が行ってる？"
      },
      "MsgSerial" : 163602,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
