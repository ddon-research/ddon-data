      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 14,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "The commander of the Knights is eager\r\nto make up for the failure, loss and dishonor\r\nof allowing Mysial to be taken away.",
        "Jp" : "騎士団長は\r\nミシアルを連れていかれた失態と不名誉を\r\n挽回しようと躍起になっているからな"
      },
      "MsgSerial" : 163604,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
