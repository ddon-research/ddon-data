      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 13,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "They probably heard my argument\r\nwith Master Joseph. \r\nThis is troublesome――",
        "Jp" : "たぶん、ジョゼフ様と僕の言い争いを\r\n聞いていたんだな\r\nまいったな――"
      },
      "MsgSerial" : 163603,
      "MsgType" : 0,
