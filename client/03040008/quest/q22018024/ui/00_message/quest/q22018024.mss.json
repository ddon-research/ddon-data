      "DispType" : 0,
      "GmdIndex" : 6,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "",
        "Jp" : "覚者さん、ありがとうございます\r\nええ、承知しております\r\n覚者さんは精一杯のことをしてくださった\r\n今回は、少しばかり運が悪かっただけ――"
      },
      "MsgSerial" : 632854,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
