      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 15,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "",
        "Jp" : "覚者さん、どうか確かめてきてもらえませんか\r\nあれから時間も経ってるし\r\n魔物も多い危険な場所なのは承知です――\r\n馬鹿げた頼みかもしれませんが、お願いします"
      },
      "MsgSerial" : 632839,
      "MsgType" : 0,
