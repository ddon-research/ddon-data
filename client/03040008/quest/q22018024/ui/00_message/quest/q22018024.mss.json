      "GmdIndex" : 1,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "",
        "Jp" : "そうですか――\r\nいいえ、それが当然ですよね！\r\nそんな都合の良い偶然があるわけないですし"
      },
      "MsgSerial" : 632850,
      "MsgType" : 0,
