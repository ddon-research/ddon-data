      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 7,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "",
        "Jp" : "兄さんが生きていてくれた\r\nそれだけで、こんなにも嬉しいんです\r\nこれからも希望を持って探し続けられます"
      },
      "MsgSerial" : 632855,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
