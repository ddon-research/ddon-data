      "DispType" : 0,
      "GmdIndex" : 17,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "",
        "Jp" : "え――俺だって？"
      },
      "MsgSerial" : 632844,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 18,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "",
        "Jp" : "シェケル――今、シェケルって言ったか\r\n生きてたんだな、アイツ――そうか――\r\nしかも――俺を探してくれていたんだな"
      },
      "MsgSerial" : 632845,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
