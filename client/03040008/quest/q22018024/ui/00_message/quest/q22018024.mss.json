      "DispType" : 0,
      "GmdIndex" : 3,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "",
        "Jp" : "――ええ\r\n覚者さん、行ってきてくださって\r\n本当にありがとうございます\r\nわたし、まだまだ探し続けますから！"
      },
      "MsgSerial" : 632852,
      "MsgType" : 0,
