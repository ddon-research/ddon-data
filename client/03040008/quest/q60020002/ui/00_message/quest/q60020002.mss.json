  "NativeMsgGroupArray" : [ {
    "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgGroup",
    "GroupNameSerial" : 0,
    "GroupSerial" : 14418,
    "GroupType" : 0,
    "GroupTypeName" : "MSG_GROUP_TYPE_NONE",
    "MsgData" : [ {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 0,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "Right then, Ser Arisen — a treasure hunt it is!\r\nFound a clue in an aged lighthouse keeper's\r\njournal, back at grandpa Rudolfo's place.",
        "Jp" : "よしきた覚者さん、宝探しだな！\r\nルドルフォの爺さん家で見た古い灯台守の\r\n日誌にあったんだよ、手掛かりが"
      },
      "MsgSerial" : 286131,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 1,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "The Roaring Tide Cave atop the cliffs on the\r\nsouth shore — back then 'twas called the Sea\r\nGod's Cave, and folk'd go there to proffer\r\nprayers, or so they say.",
        "Jp" : "南の浜辺の崖上にある《潮騒洞窟》は\r\n当時は海神様の洞窟なんて呼ばれてて\r\nお参りに行く人もいたんだって"
      },
      "MsgSerial" : 286132,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 2,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "But the cave was sealed off — seems some fool\r\nwent and ransacked the place, chasin' after the\r\n\"Sea God's Treasure.\" See? Treasure!\r\nThis must be it, right!?",
        "Jp" : "でも、洞窟は封鎖されたんだ\r\n――それというのも、\"海神様の宝\"を狙って\r\n洞窟を荒らしたヤツがいたせいらしいんだ\r\nほら宝だよ、財宝ってこれじゃないかな！？"
      },
      "MsgSerial" : 286133,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 3,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "Come to think, I knew there was a mysterious key\r\namidst the heirlooms. A hunch struck — \"Mayhap...\"\r\n— so I went and tried it. Bullseye!",
        "Jp" : "そういえば、よく分からない鍵が\r\n引継品の中にあるのは知ってたんだよね\r\nビビっときて、もしやと思って\r\n行ってみたら――大当たりってわけ！"
      },
      "MsgSerial" : 286134,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 4,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "You're sure to find the treasure, I know it. When\r\nyou do — let's split it down the middle, aye?",
        "Jp" : "あんたならきっと財宝を見つけられるよ\r\nその時は山分けでよろしくな！"
      },
      "MsgSerial" : 286135,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    } ],
    "NameDispOff" : false,
    "NpcId" : 1205,
    "NpcName" : {
      "En" : "O'Neill",
      "Jp" : "オニール"
    }
  }, {
    "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgGroup",
    "GroupNameSerial" : 0,
    "GroupSerial" : 14419,
    "GroupType" : 0,
    "GroupTypeName" : "MSG_GROUP_TYPE_NONE",
    "MsgData" : [ {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 5,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "Huh!? The treasure turned out to be a\r\nwaterfall inside the cave!?",
        "Jp" : "――えっ！？\r\n宝の正体は洞窟の中にある滝だって！？"
      },
      "MsgSerial" : 286136,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 6,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "Haah... but I see. So the village was attacked\r\nbecause Ruflow's folk angered the Sea God of\r\nthe cave — Lindwurm.",
        "Jp" : "はぁ～、でも、そうかぁ\r\n洞窟の海神様――リンドブルムを\r\nルフローの人間が怒らせたせいで\r\n村は襲われちゃったのか"
      },
      "MsgSerial" : 286137,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 7,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "Since Lord White Dragon fell, the sea wyrm's\r\nturned savage all of a sudden— 'Twould ne'er have\r\ncome to this afore, though.",
        "Jp" : "でも、\"ブリアに眠る財宝\"か――\r\nそれが本当なら確かに気になるね\r\nそういえばブリアにはもう一つ村があったんだ\r\n南の浜辺の《ルフロー》っていう廃村がね"
      },
      "MsgSerial" : 286138,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 8,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "―But was it truly just a waterfall?\r\nWas there any treasure or aught like that-",
        "Jp" : "――でも、本当に滝だけだったのか？\r\n別に財宝があったりなんか――"
      },
      "MsgSerial" : 286139,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 9,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "—Well, I suppose not.\r\n​You're the one saying so, after all.",
        "Jp" : "――まぁ、しないか\r\nあんたが言うんだしな"
      },
      "MsgSerial" : 286140,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 10,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "'Tis good the truth's come to light. If the falls\r\nare truly that fair, mayhap I'll pay 'em a\r\nvisit myself next time.",
        "Jp" : "いろいろ真相がはっきりしたのは良かったよ\r\nそんなに綺麗な滝なら\r\n今度俺も見に行ってみようかな"
      },
      "MsgSerial" : 286141,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    } ],
    "NameDispOff" : false,
    "NpcId" : 1205,
    "NpcName" : {
      "En" : "O'Neill",
      "Jp" : "オニール"
    }
  }, {
    "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgGroup",
    "GroupNameSerial" : 0,
    "GroupSerial" : 14420,
