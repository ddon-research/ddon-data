    "MsgData" : [ {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 5,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "'Tis about the Phindymian Ent's movements, yes?\r\nIt seems to have settled around \r\n<SPOT 935>...\r\nshows no sign of stirring.",
        "Jp" : "フィンダーエントの動きについて、でしょ？\r\nどうやら《<SPOT 935>》の辺りに\r\n落ち着いて、動く気は無いみたい"
      },
      "MsgSerial" : 516418,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 6,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "...Rid us that Phindymian Ent, and we will be one\r\nstep closer to my elder sister's dearest wish—the\r\nrevival of the Elan village... will we not?",
        "Jp" : "――あのフィンダーエントを討伐すれば\r\nお姉様の悲願である、エランの村復興に\r\nまた一歩近付くのよね？"
      },
      "MsgSerial" : 552336,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 7,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "Truth is... whene'er I heard my elder sister\r\nspeak of it, I always thought 'twas like a dream.",
        "Jp" : "本当はね、お姉様のお話を聞くたびに\r\nずっと夢みたいなことだなって思ってたの"
      },
      "MsgSerial" : 553266,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 8,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "'Twill take far, far more time... and surely\r\nneither I nor my elder sister will live to see\r\nthat village revived—",
        "Jp" : "もっともっと時間がかかって\r\nきっと私やお姉様は、生きているうちに\r\nその村が復興するところなんて\r\n見られないんじゃないかって――"
      },
      "MsgSerial" : 553267,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 9,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "But... 'tis truly drawing closer— \r\nSer Arisen, I beg you... \r\nsubjugate the Phindymian Ent, and return safe.",
        "Jp" : "でも、本当に近付いてるのね――\r\n覚者様、どうかフィンダーエントを討伐して\r\n無事に戻ってきてね"
      },
      "MsgSerial" : 553268,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    } ],
    "NameDispOff" : false,
    "NpcId" : 559,
    "NpcName" : {
      "En" : "Dílis",
      "Jp" : "ディリス"
    }
  }, {
    "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgGroup",
    "GroupNameSerial" : 0,
    "GroupSerial" : 19348,
    "GroupType" : 0,
    "GroupTypeName" : "MSG_GROUP_TYPE_NONE",
    "MsgData" : [ {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
