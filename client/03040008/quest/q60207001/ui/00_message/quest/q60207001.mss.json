      "DispType" : 0,
      "GmdIndex" : 8,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "I imagine examining that place would deepen our\r\ninsight into elven culture all the more.",
        "Jp" : "あそこを調べることで\r\nエルフの文化について\r\nより一層見識を深めることができると思うんだ"
      },
      "MsgSerial" : 482221,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
