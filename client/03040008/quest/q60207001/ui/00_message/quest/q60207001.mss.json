      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 7,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "The elven ruins discovered hitherto each bear a\r\ndistinct character, yet the Soaring Sky Terrace\r\nstill harbors a curious power that draws birds.",
        "Jp" : "今までに見つかっているエルフの遺跡は\r\nそれぞれ異なった特色を備えているんだけど\r\n《飛天のテラス》は今に至るまで\r\n鳥を呼び寄せるような不思議な力を残している"
      },
      "MsgSerial" : 482220,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
