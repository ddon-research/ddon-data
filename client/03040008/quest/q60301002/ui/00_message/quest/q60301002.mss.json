  "NativeMsgGroupArray" : [ {
    "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgGroup",
    "GroupNameSerial" : 0,
    "GroupSerial" : 27459,
    "GroupType" : 0,
    "GroupTypeName" : "MSG_GROUP_TYPE_NONE",
    "MsgData" : [ {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 0,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "Ho ho ho, it's been a year, hasn't it? \r\nI trust you and the people of Lestania are well. \r\nNow, this season has come once more!",
        "Jp" : "ホッホッホ、一年ぶりだな\r\n君もレスタニアの民も元気だったかな？\r\nさぁ、今年もこの季節がやってきたぞ"
      },
      "MsgSerial" : 698239,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 1,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "However, this time we also seek to find\r\n\"a certain something.\" Do you happen to know\r\nof the legend that goes, \"On Christmas,\r\na mysterious shooting star will fall?\"",
        "Jp" : "ただ、今回わしらには\"とある探し物\"もあってな\r\n「クリスマスには不思議な流れ星が落ちてくる」\r\nという伝説があるのを知っているかな？"
      },
      "MsgSerial" : 698240,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 2,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "Originally, it was folklore from our region.\r\nBut, there are rumors that the\r\n\"mysterious shooting star\"\r\nhas fallen somewhere in this land.",
        "Jp" : "元々はわしらの暮らす地方に伝わる伝承だが\r\nなんでもその\"不思議な流れ星\"が\r\nこちらの地方に落ちてきたという噂があるのだ"
      },
      "MsgSerial" : 698241,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 3,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "We are, of course, preparing for Christmas, but \r\nwould you be able to help us gather information \r\nabout this shooting star?",
        "Jp" : "クリスマスの準備はもちろんだが\r\nこの流れ星の情報収集も手伝ってもらえないかね？"
      },
      "MsgSerial" : 698242,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    } ],
    "NameDispOff" : false,
    "NpcId" : 4764,
    "NpcName" : {
      "En" : "Nicholas",
      "Jp" : "ニコラス"
    }
  }, {
    "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgGroup",
    "GroupNameSerial" : 0,
    "GroupSerial" : 27460,
    "GroupType" : 0,
    "GroupTypeName" : "MSG_GROUP_TYPE_NONE",
    "MsgData" : [ {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 4,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "Now, do you know what needs to be done first? \r\nThat's right, we start by dressing in a way\r\nbefitting the Christmas spirit.",
        "Jp" : "それではまず、やることはわかっているかな？\r\nそうだ、クリスマスに相応しい恰好から入るのだ"
      },
      "MsgSerial" : 698247,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 5,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "\"Last year's Christmas attire.\" \r\n\"The Christmas weapons\r\nnow in stock at Cameron's shop.\" \r\n\"Any equipment dyed red, to your liking.\" \r\nChoose one and wear it here, Ser.",
        "Jp" : "\"昨年と同じクリスマスの装い\"\r\n\"キャメロンの店に入荷したクリスマスの武器\"\r\n\"好きな装備を赤く染めたもの\"\r\nどれでも一つ、君の好きな物を選んで着てきなさい"
      },
      "MsgSerial" : 698284,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 6,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "Of course, \r\nthe \"Present Sack\" I gave you last year, \r\nor the \"Reindeer's Coif\" would also be fine, Ser.",
        "Jp" : "もちろん、昨年プレゼントした《プレゼントサック》\r\n《トナカイのコイフ》でもよいぞ"
      },
      "MsgSerial" : 698285,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    } ],
    "NameDispOff" : false,
    "NpcId" : 4764,
    "NpcName" : {
      "En" : "Nicholas",
      "Jp" : "ニコラス"
    }
  }, {
    "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgGroup",
    "GroupNameSerial" : 0,
    "GroupSerial" : 27469,
    "GroupType" : 0,
    "GroupTypeName" : "MSG_GROUP_TYPE_NONE",
    "MsgData" : [ {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 7,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "Ah, you've changed clothes, I see! \r\nHmm, yes, you look absolutely perfect\r\nthis year too, Ser.",
        "Jp" : "おお、着替えてきたか！\r\nふむふむ今年もバッチリのようだ"
      },
      "MsgSerial" : 698258,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 8,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "Now, let us begin the real preparations\r\nfor Christmas; I'd like you to find out\r\nwhere the shooting star has fallen.\r\nYes, Ser. Find out while you're at it.\r\nI do not mind.",
        "Jp" : "では、本格的にクリスマスの準備開始といこう\r\n流れ星の行方についても探ってもらいたいが\r\nなぁに、準備のついででかまわんよ"
      },
      "MsgSerial" : 698259,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 9,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "What kind of Christmas will this year bring? \r\nIt's truly exciting, isn't it? Ho ho ho!",
        "Jp" : "今年はどんなクリスマスになるのか\r\nワクワクするじゃないか\r\nホッホッホ"
      },
      "MsgSerial" : 698260,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    } ],
    "NameDispOff" : false,
    "NpcId" : 4764,
    "NpcName" : {
      "En" : "Nicholas",
      "Jp" : "ニコラス"
    }
  }, {
    "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgGroup",
    "GroupNameSerial" : 0,
    "GroupSerial" : 27461,
    "GroupType" : 0,
    "GroupTypeName" : "MSG_GROUP_TYPE_NONE",
    "MsgData" : [ {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
