    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 1,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "As the story goes, the Volden\r\nTunnels' collapse is credited to a creature\r\nof grand proportions.",
        "Jp" : "お話しした通り、大坑道の崩落は\r\n巨人族出現のせいでしてね"
