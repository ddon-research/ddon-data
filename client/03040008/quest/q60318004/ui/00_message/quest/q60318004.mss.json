      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 3,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "A few of the warriors what went out\r\nto scout the field...\r\nAlready trading blows with the\r\nmonsters, looks like.\r\nManaging to hold 'em back, s'pose.",
        "Jp" : "フィールドに出て様子を探ってた戦士の\r\n何人かはすでに魔物と交戦し、やつらを\r\n食い止めている状態のようだ"
      },
      "MsgSerial" : 612999,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 4,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "They could do naught but hold the line. That's\r\nwhy I came to you for aid.",
        "Jp" : "彼らは防戦するのに精一杯だった\r\nだから、俺が君に助けを求めて\r\nやってきたってわけだ"
      },
      "MsgSerial" : 659689,
      "MsgType" : 0,
      "SetMotion" : 0,
