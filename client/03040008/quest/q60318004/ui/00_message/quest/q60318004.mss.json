      "DispType" : 0,
      "GmdIndex" : 1,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "Look, any way you cut it, I'm a bandit — shady as\r\nsin, hundred percent. But you'll want to hear\r\nthis straight, aye? No jesting now.",
        "Jp" : "俺がどう見ても盗賊で\r\n怪しいことは百も承知なんだが\r\n今から話すことは真剣に聞いてくれよ"
      },
      "MsgSerial" : 585875,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
