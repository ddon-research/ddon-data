      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 2,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "Soon the Demon Army'll be upon us — 'tis true,\r\nwhat with their movements gone queer these past\r\nfew days, you've been wound tight, eh?",
        "Jp" : "もうすぐ、ここに魔軍が攻めてくる――\r\n本当なんだ、やつらの動きがおかしいからって\r\nここ数日ピリピリしてただろ"
      },
      "MsgSerial" : 612998,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
