      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "Huh!?\r\nYou wanna learn the secret to my style too?",
        "Jp" : "――む！？\r\nおまえも着こなしの秘訣を\r\n聞きにきたのか"
