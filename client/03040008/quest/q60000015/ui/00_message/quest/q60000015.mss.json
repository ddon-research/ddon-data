    "MsgData" : [ {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 8,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "Oh my, what is it?\r\nDo you have something to ask me, Ser Arisen?",
        "Jp" : "あら、何かしら\r\n覚者さまが私に聞きたいこと？"
      },
      "MsgSerial" : 271628,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 9,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "...The secret to fashion, you say?\r\nWell, I suppose it's about coordination\r\nand accessories that are in style.\r\nMy kind of fashion revolves around\r\nsmall items like sandals and pouches.",
        "Jp" : "――お洒落の秘訣ですか\r\nそうねぇ、やっぱり着合わせや\r\n流行のアクセサリ―かしら\r\n私のお洒落はサンダルやポーチなんかの小物よ"
      },
      "MsgSerial" : 271629,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 10,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "Now that I think of it, lately there've been\r\nmore trades for materials that aren't about\r\nperformance but appearance.",
        "Jp" : "そういえば、最近は性能よりも\r\n見た目が素敵な装備の材料になる\r\n素材取引が前より多くなってきたの"
      },
      "MsgSerial" : 274922,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 11,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "Oh, right. Sonia in the Workshop might\r\nknow more about that sort of thing.\r\nShe's much more stylish than I am.",
        "Jp" : "そうだわ、もしかしたらクラフトルームの\r\nソニアさんがそのあたりの事情について\r\n詳しいかもしれないわ\r\nあの人、私よりずっとお洒落だし"
      },
      "MsgSerial" : 274923,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    } ],
    "NameDispOff" : false,
    "NpcId" : 1008,
