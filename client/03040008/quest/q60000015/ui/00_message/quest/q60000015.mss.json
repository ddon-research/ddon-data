    "MsgData" : [ {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 14,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "Oh, Master Arisen,\r\nare you consulting me about fashion?",
        "Jp" : "まぁ、覚者さま\r\nお洒落についての相談、でございますか？"
      },
      "MsgSerial" : 271631,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 15,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "What...!?\r\nTo call me one of the greatest beauties\r\nin the Temple is preposterous!",
        "Jp" : "えっ――！？\r\n私が神殿でも指折りの美人など\r\nとんでもないことでございます！"
      },
      "MsgSerial" : 274980,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 16,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "But it's true that lately, more Arisen have been\r\ncrafting bold armor and charming equipment.",
        "Jp" : "ですが、確かにこのところ、大胆な鎧や\r\n魅力的な装備を製作される覚者さまが\r\n増えているのは事実です"
      },
      "MsgSerial" : 271632,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 17,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "Unfortunately, I don't know the reason myself.\r\n...But now that you mention it.",
        "Jp" : "しかし残念ですが\r\n私はその理由までは存知あげません\r\n――しかし、そういえば"
      },
      "MsgSerial" : 271633,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 18,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "Fabio's pawn, Cornelia, used to wear\r\nmuch sterner armor before.",
        "Jp" : "覚者ファビオ様のポーン、コーネリアは\r\n以前もっと厳めしい鎧をつけていたのです"
      },
      "MsgSerial" : 274959,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 19,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "But before I knew it, \r\nshe had changed into a sleeker outfit,\r\ndespite no change in ability.",
        "Jp" : "それがいつの間にか\r\n能力は変わっていないにも関わらず\r\nあのようなすっきりとした身なりになっておりました"
      },
      "MsgSerial" : 274961,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 20,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "I was curious and asked Fabio about it,\r\nbut he wouldn't tell me.",
        "Jp" : "不思議に思い\r\nファビオ様に尋ねたことがあったのですが\r\n私には教えていただけませんでした"
      },
      "MsgSerial" : 274960,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
    }, {
      "@class" : "org.sehkah.ddon.tools.extractor.common.logic.resource.entity.ui.MsgData",
      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 21,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "Perhaps you could ask Cornelia herself\r\nabout the secret.",
        "Jp" : "コーネリア本人にその秘密を聞いてみては\r\nいかがでしょうか？"
