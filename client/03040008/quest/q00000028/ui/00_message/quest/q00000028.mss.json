      "DispTime" : 0,
      "DispType" : 0,
      "GmdIndex" : 12,
      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "I mentioned this since you are Arisen, \r\nbut if you could, keep this to yourself.",
        "Jp" : "覚者さまだからお話ししましたけど\r\nできればそっとしてあげてくださいね"
      },
      "MsgSerial" : 384468,
      "MsgType" : 0,
      "SetMotion" : 0,
      "TalkFaceType" : 0,
      "VoiceReqNo" : -1
