      "JumpGroupSerial" : 0,
      "Message" : {
        "En" : "Greetings, Master Arisen! \r\nWhat can I do for you? \r\nDo you have something you want to ask?",
        "Jp" : "こんにちは、覚者さま！\r\nはいなんでしょう\r\nわたしに聞きたいこと、ですか？"
